# URL da API consumida pelo app.
# Sem essa variável, o app usa a produção (https://api.tozzo.uk).
#
# Homologação:
# EXPO_PUBLIC_API_URL=https://dev-api.tozzo.uk
#
# Dev local (ngrok):
# EXPO_PUBLIC_API_URL=https://SEU-TUNEL.ngrok-free.app
EXPO_PUBLIC_API_URL=https://dev-api.tozzo.uk

# GoTrue autentica e renova a sessao; a API acima continua servindo dados.
# Sem override: ${EXPO_PUBLIC_API_URL}/gotrue.
EXPO_PUBLIC_AUTH_URL=https://dev-api.tozzo.uk/gotrue
# Emulador Android local:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3001
# EXPO_PUBLIC_AUTH_URL=http://10.0.2.2:9999
