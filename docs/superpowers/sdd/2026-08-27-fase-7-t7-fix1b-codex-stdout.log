244 │ function emptyPaginatedSales(page: number, limit: number): RecentSalesPaginated {
245 │   return {
246 │     sales: [],
247 │     closing: 0,
248 │     pagination: {
249 │       page,
250 │       limit,
251 │       total: 0,
252 │       totalPages: 0,
253 │       hasNextPage: false,
254 │     },
255 │   };
