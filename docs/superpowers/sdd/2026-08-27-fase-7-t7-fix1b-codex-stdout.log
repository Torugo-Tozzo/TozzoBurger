 35 │ type SaleItemInput = {
 36 │   productId: string;
 37 │   quantity: number;
 38 │   unitPriceAtSale?: number;
 39 │ };
 40 │ 
 41 │ type SaleSyncInput = SaleData & {
 42 │   items?: SaleItemData[];
 43 │   products?: SaleItemData[];
 44 │   created_at?: number | string | Date;
 45 │   sold_at?: number | string | Date;
 46 │   updatedAt?: number | string | Date;
 47 │   establishment_id?: string | number | null;
 48 │   seller_id?: string | number | null;
 49 │   order_id?: string | null;
 50 │   is_cancelled?: boolean | null;
 51 │   created_by_name?: string | null;
 52 │ };
 53 │ 
 54 │ type SaleProductRow = {
 55 │   name: string;
 56 │   quantity: number;
 57 │ };
 58 │ 
 59 │ const SALES_SUMMARY_PAGE_SIZE = 100;
 60 │ 
 61 │ function normalizeEstablishmentId(value: string | number | null | undefined): string | null {
 62 │   if (value == null) return null;
 63 │   const normalized = String(value).trim();
 64 │   return normalized.length > 0 ? normalized : null;
 65 │ }
 66 │ 
 67 │ function finiteNumber(value: unknown, fallback = 0): number {
 68 │   const parsed = typeof value === 'string'
 69 │     ? Number(value.trim().replace(',', '.'))
 70 │     : Number(value);
 71 │   return Number.isFinite(parsed) ? parsed : fallback;
 72 │ }
 73 │ 
 74 │ function epoch(value: unknown, fallback: number): number {
 75 │   if (value instanceof Date) {
 76 │     const timestamp = value.getTime();
 77 │     return Number.isFinite(timestamp) ? timestamp : fallback;
 78 │   }
 79 │ 
 80 │   if (typeof value === 'number' && Number.isFinite(value)) return value;
 81 │ 
 82 │   if (typeof value === 'string') {
 83 │     const timestamp = Date.parse(value);
 84 │     if (Number.isFinite(timestamp)) return timestamp;
 85 │   }
 86 │ 
 87 │   return fallback;
 88 │ }
