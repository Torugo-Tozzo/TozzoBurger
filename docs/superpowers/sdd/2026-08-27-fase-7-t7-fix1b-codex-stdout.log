221 │ function displayedProducts(products: SaleProductRow[]): string[] {
222 │   const productNames = products.map((product) => `( ${product.quantity}x ) ${product.name}`);
223 │   return productNames.length > 3
224 │     ? [...productNames.slice(0, 3), '...']
225 │     : productNames;
