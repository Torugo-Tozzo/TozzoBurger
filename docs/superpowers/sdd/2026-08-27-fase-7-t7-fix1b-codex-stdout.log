258 │ async function fetchSales(query: LocalSalesQuery): Promise<SaleModel[]> {
259 │   return saleCollection()
260 │     .query(
261 │       ...query.clauses,
262 │       Q.sortBy('sold_at', Q.desc),
263 │       Q.sortBy('id', Q.desc),
264 │     )
265 │     .fetch();
266 │ }
267 │ 
268 │ async function fetchSalesPage(
269 │   query: LocalSalesQuery,
270 │   page: number,
271 │   limit: number,
272 │ ): Promise<SaleModel[]> {
273 │   return saleCollection()
274 │     .query(
275 │       ...query.baseClauses,
276 │       Q.sortBy('sold_at', Q.desc),
277 │       Q.sortBy('id', Q.desc),
278 │       Q.take(limit),
279 │       Q.skip((page - 1) * limit),
280 │     )
281 │     .fetch();
282 │ }
283 │ 
284 │ async function summarizeSales(query: LocalSalesQuery): Promise<{ total: number; closing: number }> {
285 │   let page = 1;
286 │   let total = 0;
287 │   let closing = 0;
288 │ 
289 │   while (true) {
290 │     const salesPage = await fetchSalesPage(query, page, SALES_SUMMARY_PAGE_SIZE);
291 │     const matchingSales = salesPage.filter((sale) => query.matchesTime(sale.soldAt));
292 │     total += matchingSales.length;
293 │     closing += matchingSales.reduce((sum, sale) => sum + sale.total, 0);
294 │ 
295 │     if (salesPage.length < SALES_SUMMARY_PAGE_SIZE) break;
296 │     page += 1;
297 │   }
298 │ 
299 │   return { total, closing };
300 │ }
301 │ 
302 │ async function fetchAllSales(query: LocalSalesQuery): Promise<SaleModel[]> {
303 │   const allSales: SaleModel[] = [];
304 │   let page = 1;
305 │ 
306 │   while (true) {
307 │     const salesPage = await fetchSalesPage(query, page, SALES_SUMMARY_PAGE_SIZE);
308 │     allSales.push(...salesPage.filter((sale) => query.matchesTime(sale.soldAt)));
309 │ 
310 │     if (salesPage.length < SALES_SUMMARY_PAGE_SIZE) break;
311 │     page += 1;
312 │   }
313 │ 
314 │   return allSales;
315 │ }
