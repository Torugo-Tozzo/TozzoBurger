188 │     orderId: sale.orderId,
189 │     updated_at: sale.updatedAt.getTime(),
190 │     deleted_at: null,
191 │     sync_status: sale.syncStatus === 'synced' ? 'synced' : 'pending',
192 │     createdBy: sale.sellerId || null,
193 │     createdByName: sale.createdByName ?? createdByName,
