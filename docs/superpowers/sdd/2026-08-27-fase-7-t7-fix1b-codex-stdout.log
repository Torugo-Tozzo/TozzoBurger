114 │ async function findSale(id: string, establishmentId: string | null): Promise<SaleModel | null> {
115 │   if (!establishmentId) return null;
116 │ 
117 │   const [sale] = await saleCollection()
118 │     .query(Q.where('id', id), Q.where('establishment_id', establishmentId))
119 │     .fetch();
120 │   return sale ?? null;
121 │ }
