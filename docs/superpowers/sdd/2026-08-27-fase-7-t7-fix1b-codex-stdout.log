  +    allSales.push(...salesPage.filter((sale) => query.matchesTime(sale.soldAt)));
  +
  +    if (salesPage.length < SALES_SUMMARY_PAGE_SIZE) break;
  +    page += 1;
  +  }
  +
  +  return allSales;
