228 │ async function toSaleWithProducts(
229 │   sale: SaleModel,
230 │   establishmentId: string,
231 │ ): Promise<SaleWithProducts> {
232 │   const [items, createdByName] = await Promise.all([
233 │     fetchSaleItems(sale.id, establishmentId),
234 │     createdByNameForSale(sale, establishmentId),
235 │   ]);
236 │   const products = await productNamesForItems(items, establishmentId);
237 │ 
238 │   return {
239 │     ...toSaleData(sale, createdByName),
240 │     products: displayedProducts(products),
241 │   };
