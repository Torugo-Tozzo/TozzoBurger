import { type SQLiteDatabase } from "expo-sqlite"

const SCHEMA_VERSION = 1006;

const TABLE_RENAMES = [
  ['TB_PRODUTOS', 'TB_PRODUCTS'],
  ['TB_TP_PRODUTO', 'TB_PRODUCT_TYPES'],
  ['TB_VENDAS', 'TB_SALES'],
