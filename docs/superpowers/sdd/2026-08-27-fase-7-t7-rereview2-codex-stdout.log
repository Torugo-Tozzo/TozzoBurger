535 │   async function getSaleById(saleId: string) {
536 │     if (!currentEstablishmentId) {
537 │       throw new Error(`Venda com ID ${saleId} não encontrada.`);
538 │     }
539 │ 
540 │     const sale = await findSale(String(saleId), currentEstablishmentId);
541 │     if (!sale) throw new Error(`Venda com ID ${saleId} não encontrada.`);
542 │ 
543 │     const [items, createdByName] = await Promise.all([
544 │       fetchSaleItems(sale.id, currentEstablishmentId),
545 │       createdByNameForSale(sale, currentEstablishmentId),
