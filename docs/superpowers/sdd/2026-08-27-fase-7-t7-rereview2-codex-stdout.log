177 │ async function toOrderWithProducts(
178 │   order: OrderModel,
179 │   establishmentId: string,
180 │ ): Promise<OrderWithProducts> {
181 │   const items = await fetchOrderItems(order.id, establishmentId);
182 │   const products = await productNamesForItems(items, establishmentId);
183 │   return { ...toOrderData(order), products: displayedProducts(products) };
184 │ }
