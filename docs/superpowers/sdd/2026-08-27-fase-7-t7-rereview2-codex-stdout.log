211 │ function toFiniteNumber(value: unknown, fallback = 0): number {
212 │   if (typeof value === 'string') {
213 │     const parsed = Number(value.trim().replace(',', '.'));
214 │     return Number.isFinite(parsed) ? parsed : fallback;
215 │   }
216 │   const parsed = Number(value);
217 │   return Number.isFinite(parsed) ? parsed : fallback;
218 │ }
219 │ 
220 │ function optionalFilterNumber(value: number | string | null | undefined): number | undefined {
221 │   if (value == null || (typeof value === 'string' && value.trim() === '')) return undefined;
222 │   const parsed = toFiniteNumber(value, Number.NaN);
223 │   return Number.isFinite(parsed) ? parsed : undefined;
224 │ }
