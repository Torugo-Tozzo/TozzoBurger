625 │ 
626 │     const query = buildLocalSalesQuery({ dataInicial: data, dataFinal: data }, currentEstablishmentId);
627 │     const sales = await fetchAllSales(query);
628 │     return Promise.all(sales.map((sale) => toSaleWithProducts(sale, currentEstablishmentId)));
629 │   }
