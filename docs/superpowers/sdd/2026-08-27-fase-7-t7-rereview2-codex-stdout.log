124 │ async function findProduct(id: string, establishmentId: string): Promise<ProductModel | null> {
125 │   const [product] = await productCollection()
126 │     .query(Q.where('id', id), Q.where('establishment_id', establishmentId))
127 │     .fetch();
128 │   return product ?? null;
