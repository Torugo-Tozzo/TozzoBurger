115 │ async function findOrder(id: string, establishmentId: string | null): Promise<OrderModel | null> {
116 │   if (!establishmentId) return null;
117 │ 
118 │   const [order] = await orderCollection()
119 │     .query(Q.where('id', id), Q.where('establishment_id', establishmentId))
120 │     .fetch();
121 │   return order ?? null;
122 │ }
