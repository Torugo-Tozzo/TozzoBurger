294 │ async function summarizeSales(query: LocalSalesQuery): Promise<{ total: number; closing: number }> {
295 │   let page = 1;
296 │   let total = 0;
297 │   let closing = 0;
298 │ 
299 │   while (true) {
300 │     const salesPage = await fetchSalesPage(query, page, SALES_SUMMARY_PAGE_SIZE);
301 │     const matchingSales = salesPage.filter((sale) => query.matchesTime(sale.soldAt));
302 │     total += matchingSales.length;
303 │     closing += matchingSales.reduce((sum, sale) => sum + sale.total, 0);
304 │ 
305 │     if (salesPage.length < SALES_SUMMARY_PAGE_SIZE) break;
306 │     page += 1;
307 │   }
308 │ 
309 │   return { total, closing };
310 │ }
311 │ 
312 │ async function fetchAllSales(query: LocalSalesQuery): Promise<SaleModel[]> {
313 │   const allSales: SaleModel[] = [];
314 │   let page = 1;
315 │ 
316 │   while (true) {
317 │     const salesPage = await fetchSalesPage(query, page, SALES_SUMMARY_PAGE_SIZE);
318 │     allSales.push(...salesPage.filter((sale) => query.matchesTime(sale.soldAt)));
319 │ 
320 │     if (salesPage.length < SALES_SUMMARY_PAGE_SIZE) break;
321 │     page += 1;
322 │   }
323 │ 
324 │   return allSales;
325 │ }
