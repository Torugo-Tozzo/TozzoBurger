 72 │ }
 73 │ 
 74 │ function epoch(value: unknown, fallback: number): number {
 75 │   if (value instanceof Date) {
 76 │     const timestamp = value.getTime();
 77 │     return Number.isFinite(timestamp) ? timestamp : fallback;
 78 │   }
 79 │ 
 80 │   if (typeof value === 'number' && Number.isFinite(value)) return value;
 81 │ 
 82 │   if (typeof value === 'string') {
 83 │     const timestamp = Date.parse(value);
 84 │     if (Number.isFinite(timestamp)) return timestamp;
 85 │   }
 86 │ 
 87 │   return fallback;
 88 │ }
