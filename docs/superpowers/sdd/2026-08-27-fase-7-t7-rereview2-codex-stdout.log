433 │   async function listRecentOrders(): Promise<Record<string, OrderWithProducts[]>> {
434 │     if (!currentEstablishmentId) return {};
435 │ 
436 │     const threeDaysAgo = new Date();
437 │     threeDaysAgo.setDate(threeDaysAgo.getDate() - 3);
438 │ 
439 │     const orders = await orderCollection()
440 │       .query(
441 │         Q.where('establishment_id', currentEstablishmentId),
442 │         Q.where('is_open', true),
443 │         Q.where('opened_at', Q.gte(threeDaysAgo.getTime())),
444 │         Q.sortBy('opened_at', Q.desc),
445 │         Q.sortBy('id', Q.desc),
446 │         Q.take(500),
447 │       )
448 │       .fetch();
449 │ 
450 │     return groupOrdersByDate(
451 │       await Promise.all(orders.map((order) => toOrderWithProducts(order, currentEstablishmentId!))),
452 │     );
453 │   }
