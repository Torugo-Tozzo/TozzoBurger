 36 │ function asEstablishmentId(value: string | number | null | undefined): string {
 37 │   return value == null || value === '' ? '' : String(value);
 38 │ }
 39 │ 
 40 │ function normalizeEstablishmentId(value: string | number | null | undefined): string | null {
 41 │   const normalized = asEstablishmentId(value);
 42 │   return normalized === '' ? null : normalized;
 43 │ }
 44 │ 
 45 │ function isOrderItemStatus(value: unknown): value is OrderItemStatus {
 46 │   return (
 47 │     value === ORDER_ITEM_STATUS.REQUESTED ||
 48 │     value === ORDER_ITEM_STATUS.IN_PREPARATION ||
 49 │     value === ORDER_ITEM_STATUS.DELIVERED
 50 │   );
 51 │ }
 52 │ 
 53 │ function orderItemStatus(value: unknown): OrderItemStatus {
 54 │   if (value == null) return ORDER_ITEM_STATUS.REQUESTED;
 55 │   if (!isOrderItemStatus(value)) throw new Error('Status de item inválido');
 56 │   return value;
 57 │ }
 58 │ 
 59 │ function epoch(value: unknown, fallback: number): number {
 60 │   if (value instanceof Date) {
 61 │     const timestamp = value.getTime();
 62 │     return Number.isFinite(timestamp) ? timestamp : fallback;
 63 │   }
 64 │ 
 65 │   if (typeof value === 'number' && Number.isFinite(value)) return value;
 66 │ 
 67 │   if (typeof value === 'string') {
 68 │     const timestamp = Date.parse(value);
 69 │     if (Number.isFinite(timestamp)) return timestamp;
 70 │   }
 71 │ 
 72 │   return fallback;
 73 │ }
