426 │   async function removeOrder(orderId: string) {
427 │     const order = await findOrder(String(orderId), currentEstablishmentId);
428 │ 
429 │     if (order) await database.write(() => order.markAsDeleted());
430 │     markChanged('orders');
431 │   }
