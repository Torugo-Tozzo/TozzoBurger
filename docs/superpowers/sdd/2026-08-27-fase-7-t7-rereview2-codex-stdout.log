 92 │ async function seedProduct(
 93 │   database: Database,
 94 │   data: { id: string; name: string; price: number; establishmentId: string; productTypeId?: string },
 95 │ ) {
 96 │   const timestamp = new Date('2026-08-20T09:00:00.000Z').getTime();
 97 │   const product = database.get<Product>('products').prepareCreateFromDirtyRaw({
 98 │     id: data.id,
 99 │     _status: 'synced',
100 │     _changed: '',
101 │     name: data.name,
102 │     price: data.price,
103 │     product_type_id: data.productTypeId ?? null,
104 │     source_product_id: null,
105 │     ingredients: null,
106 │     establishment_id: data.establishmentId,
107 │     created_at: timestamp,
108 │     updated_at: timestamp,
109 │   });
110 │ 
111 │   await database.write(() => database.batch(product));
112 │   return product;
113 │ }
114 │ 
115 │ async function seedOrder(
116 │   database: Database,
117 │   data: {
118 │     id: string;
119 │     establishmentId: string;
120 │     total: number;
121 │     customerName?: string | null;
122 │     sellerId?: string;
123 │     openedAt?: Date;
124 │     items: { productId: string; quantity: number; status: 'REQUESTED' | 'IN_PREPARATION' | 'DELIVERED'; unitPriceAtOrder: number }[];
125 │   },
126 │ ) {
127 │   const timestamp = (data.openedAt ?? new Date('2026-08-20T10:00:00.000Z')).getTime();
128 │   const order = database.get<Order>('orders').prepareCreateFromDirtyRaw({
129 │     id: data.id,
130 │     _status: 'synced',
131 │     _changed: '',
132 │     total: data.total,
133 │     opened_at: timestamp,
134 │     customer_name: data.customerName ?? null,
135 │     is_open: true,
136 │     establishment_id: data.establishmentId,
137 │     seller_id: data.sellerId ?? '',
138 │     created_at: timestamp,
139 │     updated_at: timestamp,
140 │   });
141 │   const items = data.items.map((item) => database.get<OrderItem>('order_items').prepareCreateFromDirtyRaw({
142 │     id: `${data.id}-${item.productId}-${item.quantity}`,
143 │     _status: 'synced',
144 │     _changed: '',
145 │     quantity: item.quantity,
146 │     status: item.status,
147 │     order_id: data.id,
148 │     product_id: item.productId,
149 │     unit_price_at_order: item.unitPriceAtOrder,
150 │     created_at: timestamp,
151 │     updated_at: timestamp,
152 │   }));
153 │ 
154 │   await database.write(() => database.batch(order, ...items));
155 │   return order;
156 │ }
157 │ 
158 │ async function seedSale(
159 │   database: Database,
160 │   data: {
161 │     id: string;
162 │     establishmentId: string;
163 │     soldAt: Date;
164 │     total: number;
165 │     productId: string;
166 │     quantity: number;
167 │     unitPriceAtSale: number;
168 │     customerName?: string | null;
169 │   },
170 │ ) {
171 │   const timestamp = data.soldAt.getTime();
172 │   const sale = database.get<Sale>('sales').prepareCreateFromDirtyRaw({
173 │     id: data.id,
174 │     _status: 'synced',
175 │     _changed: '',
176 │     total: data.total,
177 │     sold_at: timestamp,
178 │     customer_name: data.customerName ?? null,
179 │     is_cancelled: false,
180 │     establishment_id: data.establishmentId,
181 │     seller_id: '',
182 │     order_id: null,
183 │     created_at: timestamp,
184 │     updated_at: timestamp,
185 │   });
186 │   const item = database.get<SaleItem>('sale_items').prepareCreateFromDirtyRaw({
187 │     id: `${data.id}-item`,
188 │     _status: 'synced',
189 │     _changed: '',
190 │     quantity: data.quantity,
191 │     sale_id: data.id,
192 │     product_id: data.productId,
193 │     unit_price_at_sale: data.unitPriceAtSale,
194 │     created_at: timestamp,
195 │     updated_at: timestamp,
196 │   });
197 │ 
198 │   await database.write(() => database.batch(sale, item));
199 │   return sale;
200 │ }
