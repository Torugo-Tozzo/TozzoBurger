327 │ export function useSaleDatabase() {
328 │   const { user } = useAuth();
329 │   const currentEstablishmentId = normalizeEstablishmentId(user?.establishmentId);
330 │ 
331 │   async function createSale(
332 │     items: SaleItemInput[],
333 │     customerName?: string,
334 │     createdBy?: string | number | null,
335 │     createdByName?: string | null,
336 │   ) {
337 │     if (!currentEstablishmentId) {
338 │       throw new Error('Cannot create a sale without an authenticated establishment');
339 │     }
340 │ 
341 │     const products = await Promise.all(items.map(async (item) => {
342 │       const product = await findProduct(String(item.productId), currentEstablishmentId);
343 │       if (!product) throw new Error(`Produto ${item.productId} não encontrado`);
344 │       return { item, product };
345 │     }));
346 │     const total = products.reduce(
347 │       (sum, { item, product }) => sum + product.price * Number(item.quantity),
348 │       0,
349 │     );
350 │     const now = new Date();
351 │     const sellerId = createdBy == null ? '' : String(createdBy);
352 │ 
353 │     const sale = await database.write(async () => {
354 │       const createdSale = await saleCollection().create((record) => {
355 │         record.total = total;
356 │         record.soldAt = now;
357 │         record.customerName = customerName ?? null;
358 │         record.createdByName = createdByName ?? null;
359 │         record.isCancelled = false;
360 │         record.establishmentId = currentEstablishmentId;
361 │         record.sellerId = sellerId;
362 │         record.orderId = null;
363 │         record.createdAt = now;
364 │         record.updatedAt = now;
365 │       });
366 │ 
367 │       for (const { item, product } of products) {
368 │         await saleItemCollection().create((record) => {
369 │           record.quantity = Number(item.quantity);
370 │           record.saleId = createdSale.id;
371 │           record.sale.set(createdSale);
372 │           record.productId = product.id;
373 │           record.product.set(product);
374 │           record.unitPriceAtSale = product.price;
375 │           record.createdAt = now;
376 │           record.updatedAt = now;
377 │         });
378 │       }
379 │ 
380 │       return createdSale;
381 │     });
382 │ 
383 │     markChanged('sales');
384 │     return { saleId: sale.id };
385 │   }
386 │ 
387 │   async function createSaleFromOrder(
388 │     orderId: string,
389 │     customerName?: string | null,
390 │     createdBy?: string | number | null,
391 │     createdByName?: string | null,
392 │   ) {
393 │     if (!currentEstablishmentId) {
394 │       throw new Error('Cannot create a sale without an authenticated establishment');
395 │     }
396 │ 
397 │     const sale = await database.write(async () => {
398 │       const order = await findOrder(String(orderId), currentEstablishmentId);
399 │       if (!order) throw new Error(`Pedido com ID ${orderId} não encontrado.`);
400 │       if (!order.isOpen) throw new Error(`Pedido com ID ${orderId} já está fechado.`);
401 │ 
402 │       const items = await fetchOrderItems(order.id, currentEstablishmentId);
403 │       const products = await Promise.all(items.map(async (item) => {
404 │         const product = await findProduct(item.productId, currentEstablishmentId);
405 │         if (!product) throw new Error(`Produto ${item.productId} não encontrado`);
406 │         const unitPriceAtSale = Number.isFinite(item.unitPriceAtOrder)
407 │           ? item.unitPriceAtOrder
408 │           : product.price;
409 │         return { item, product, unitPriceAtSale };
410 │       }));
411 │       const total = products.reduce(
412 │         (sum, { item, unitPriceAtSale }) => sum + Number(item.quantity) * unitPriceAtSale,
413 │         0,
414 │       );
415 │       const now = new Date();
416 │       const sellerId = order.sellerId || (createdBy == null ? '' : String(createdBy));
417 │ 
418 │       const createdSale = await saleCollection().create((record) => {
419 │         record.total = total;
420 │         record.soldAt = now;
421 │         record.customerName = customerName === undefined ? order.customerName : customerName;
422 │         record.createdByName = createdByName ?? null;
423 │         record.isCancelled = false;
424 │         record.establishmentId = currentEstablishmentId;
425 │         record.sellerId = sellerId;
426 │         record.orderId = order.id;
427 │         record.createdAt = now;
428 │         record.updatedAt = now;
429 │       });
430 │ 
431 │       for (const { item, product, unitPriceAtSale } of products) {
432 │         await saleItemCollection().create((record) => {
433 │           record.quantity = item.quantity;
434 │           record.saleId = createdSale.id;
435 │           record.sale.set(createdSale);
436 │           record.productId = product.id;
437 │           record.product.set(product);
438 │           record.unitPriceAtSale = unitPriceAtSale;
439 │           record.createdAt = now;
440 │           record.updatedAt = now;
441 │         });
442 │       }
443 │ 
444 │       await order.update((record) => {
445 │         record.isOpen = false;
446 │         record.updatedAt = now;
447 │       });
448 │ 
449 │       return createdSale;
450 │     });
451 │ 
452 │     markChanged('sales');
453 │     markChanged('orders');
454 │     return { saleId: sale.id };
455 │   }
456 │ 
457 │   async function createFromSync(data: SaleSyncInput) {
458 │     if (!currentEstablishmentId) {
459 │       throw new Error('Cannot sync a sale without an authenticated establishment');
460 │     }
461 │ 
462 │     const raw = data as SaleSyncInput;
463 │     const incomingEstablishmentId = normalizeEstablishmentId(
464 │       raw.establishmentId ?? raw.establishment_id,
465 │     );
466 │     if (incomingEstablishmentId && incomingEstablishmentId !== currentEstablishmentId) {
467 │       throw new Error('Cannot sync a sale from another establishment');
468 │     }
469 │ 
470 │     const id = String(raw.id ?? '').trim();
471 │     if (!id) throw new Error('ID inválido');
472 │ 
473 │     const now = Date.now();
474 │     const updatedAt = epoch(raw.updated_at ?? raw.updatedAt, now);
475 │     const createdAt = epoch(raw.created_at, updatedAt);
476 │     const soldAt = epoch(raw.soldAt ?? raw.sold_at, createdAt);
477 │     const seller = raw.sellerId ?? raw.seller_id ?? raw.createdBy ?? '';
478 │     const orderId = raw.orderId ?? raw.order_id ?? null;
479 │     const isCancelled = raw.isCancelled === true || raw.is_cancelled === true;
480 │     const items = Array.isArray(raw.items)
481 │       ? raw.items
482 │       : Array.isArray(raw.products)
483 │         ? raw.products
484 │         : [];
485 │ 
486 │     const preparedSale = saleCollection().prepareCreateFromDirtyRaw({
487 │       id,
488 │       _status: 'synced',
489 │       _changed: '',
490 │       total: finiteNumber(raw.total),
491 │       sold_at: soldAt,
492 │       customer_name: raw.customerName ?? null,
493 │       created_by_name: raw.createdByName ?? raw.created_by_name ?? null,
494 │       is_cancelled: isCancelled,
495 │       establishment_id: currentEstablishmentId,
496 │       seller_id: seller == null ? '' : String(seller),
497 │       order_id: orderId == null ? null : String(orderId),
498 │       created_at: createdAt,
499 │       updated_at: updatedAt,
500 │     });
501 │ 
502 │     const preparedItems = await Promise.all(items.map(async (item) => {
503 │       const rawItem = item as SaleItemData & {
504 │         product_id?: string;
505 │         unit_price_at_sale?: number;
506 │         created_at?: number | string | Date;
507 │         updated_at?: number | string | Date;
508 │       };
509 │       const incomingProductId = String(rawItem.productId ?? rawItem.product_id ?? '');
510 │       const product = await findProduct(incomingProductId, currentEstablishmentId);
511 │       const itemCreatedAt = epoch(rawItem.created_at, createdAt);
512 │       const itemUpdatedAt = epoch(rawItem.updated_at, updatedAt);
513 │       const unitPriceAtSale = finiteNumber(
514 │         rawItem.unitPriceAtSale ?? rawItem.unit_price_at_sale ?? product?.price,
515 │       );
516 │ 
517 │       return saleItemCollection().prepareCreateFromDirtyRaw({
518 │         id: rawItem.id ? String(rawItem.id) : generateUUID(),
519 │         _status: 'synced',
520 │         _changed: '',
521 │         quantity: finiteNumber(rawItem.quantity),
522 │         sale_id: id,
523 │         product_id: product?.id ?? incomingProductId,
524 │         unit_price_at_sale: unitPriceAtSale,
525 │         created_at: itemCreatedAt,
526 │         updated_at: itemUpdatedAt,
527 │       });
528 │     }));
529 │ 
530 │     await database.write(() => database.batch(preparedSale, ...preparedItems));
531 │     markChanged('sales');
532 │     return { saleId: id };
533 │   }
