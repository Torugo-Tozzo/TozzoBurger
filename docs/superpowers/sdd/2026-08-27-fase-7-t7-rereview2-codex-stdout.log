 50 │ import { Database, Q } from '@nozbe/watermelondb';
 51 │ import SQLiteAdapter from '@nozbe/watermelondb/adapters/sqlite';
 52 │ 
 53 │ import { useAuth } from '../../context/AuthContext';
 54 │ import { markChanged } from '../tableWatermark';
 55 │ import { useSaleDatabase } from '../useSaleDatabase';
 56 │ import { buildLocalSalesQuery } from '../salesQuery';
 57 │ import migrations from '../watermelon/migrations';
 58 │ import Order from '../watermelon/models/Order';
 59 │ import OrderItem from '../watermelon/models/OrderItem';
 60 │ import Printer from '../watermelon/models/Printer';
 61 │ import Product from '../watermelon/models/Product';
 62 │ import ProductType from '../watermelon/models/ProductType';
 63 │ import Sale from '../watermelon/models/Sale';
 64 │ import SaleItem from '../watermelon/models/SaleItem';
 65 │ import User from '../watermelon/models/User';
 66 │ import schema from '../watermelon/schema';
 67 │ 
 68 │ const modelClasses = [Product, ProductType, Order, OrderItem, Sale, SaleItem, User, Printer];
 69 │ const mockMarkChanged = markChanged as jest.Mock;
 70 │ const mockUseAuth = useAuth as jest.MockedFunction<typeof useAuth>;
 71 │ 
 72 │ function makeDatabase() {
 73 │   const adapter = new SQLiteAdapter({
 74 │     schema,
 75 │     migrations,
 76 │     dbName: ':memory:',
 77 │     jsi: true,
 78 │     onSetUpError: (error) => {
 79 │       throw error;
 80 │     },
 81 │   });
 82 │ 
 83 │   return new Database({ adapter, modelClasses });
 84 │ }
 85 │ 
 86 │ function setCurrentEstablishment(establishmentId: string | number | null) {
 87 │   mockUseAuth.mockReturnValue({
 88 │     user: { establishmentId },
 89 │   } as ReturnType<typeof useAuth>);
 90 │ }
