198 │ async function ensureChildReferencesBelongToEstablishment(
199 │   changes: SyncChangeSet,
200 │   childTable: 'order_items' | 'sale_items',
201 │   childReferenceColumn: 'order_id' | 'sale_id',
202 │   childReferenceProperty: 'orderId' | 'saleId',
203 │   parentTable: 'orders' | 'sales',
204 │   establishmentId: string,
205 │ ): Promise<void> {
206 │   const childChanges = changes[childTable];
207 │   const referenceIds = new Set<string>();
208 │ 
209 │   for (const record of rawRecords(changes, childTable)) {
210 │     const referenceId = record[childReferenceColumn];
211 │     if (referenceId !== null && referenceId !== undefined && String(referenceId).trim().length > 0) {
212 │       referenceIds.add(String(referenceId));
213 │     }
214 │   }
215 │ 
216 │   const deletedChildren = await recordsByIds(childTable, childChanges.deleted);
217 │   for (const record of deletedChildren) {
218 │     const referenceId = record?.[childReferenceProperty];
219 │     if (referenceId !== null && referenceId !== undefined && String(referenceId).trim().length > 0) {
220 │       referenceIds.add(String(referenceId));
221 │     }
222 │   }
223 │ 
224 │   if (referenceIds.size === 0) return;
225 │ 
226 │   const incomingParentIds = new Set(rawRecords(changes, parentTable).map((record) => String(record.id)));
227 │   const localParentIds = [...referenceIds].filter((id) => !incomingParentIds.has(id));
228 │   const localParents = await recordsByIds(parentTable, localParentIds);
229 │   const foundLocalParentIds = new Set(localParents.map((record) => String(record.id)));
230 │ 
231 │   for (const record of localParents) {
232 │     ensureRecordBelongsToEstablishment(parentTable, record, establishmentId);
233 │   }
234 │ 
235 │   for (const id of localParentIds) {
236 │     if (!foundLocalParentIds.has(id)) {
237 │       throw new Error(`[sync] ${childTable} record references an unknown ${parentTable} record`);
238 │     }
239 │   }
240 │ }
