569 │   async function listRecentSales(): Promise<RecentSalesGrouped>;
570 │   async function listRecentSales(filters: SalesFilters): Promise<RecentSalesPaginated>;
571 │   async function listRecentSales(filters?: SalesFilters): Promise<RecentSalesGrouped | RecentSalesPaginated> {
572 │     if (!currentEstablishmentId) {
573 │       return filters === undefined ? {} : emptyPaginatedSales(1, DEFAULT_SALES_LIMIT);
574 │     }
575 │ 
576 │     const query = buildLocalSalesQuery(filters ?? {}, currentEstablishmentId);
577 │     if (filters === undefined) {
578 │       const groupedSales = await fetchAllSales(query);
579 │       const salesWithProducts = await Promise.all(
580 │         groupedSales.map((sale) => toSaleWithProducts(sale, currentEstablishmentId)),
581 │       );
582 │       const salesByDate: RecentSalesGrouped = {};
583 │       for (const sale of salesWithProducts) {
584 │         const date = new Date(sale.soldAt).toLocaleDateString();
585 │         if (!salesByDate[date]) salesByDate[date] = [];
586 │         salesByDate[date].push(sale);
587 │       }
588 │       return salesByDate;
589 │     }
590 │ 
591 │     let pageSales: SaleModel[];
592 │     let total: number;
593 │     let closing: number;
594 │     if (query.hasTimeFilter) {
595 │       const matchingSales = (await fetchSalesWithoutPagination(query))
596 │         .filter((sale) => query.matchesTime(sale.soldAt));
597 │       total = matchingSales.length;
598 │       closing = matchingSales.reduce((sum, sale) => sum + sale.total, 0);
599 │       const pageStart = (query.page - 1) * query.limit;
600 │       pageSales = matchingSales.slice(pageStart, pageStart + query.limit);
601 │     } else {
602 │       pageSales = await fetchSales(query);
603 │       ({ total, closing } = await summarizeSales(query));
604 │     }
605 │     const salesWithProducts = await Promise.all(
606 │       pageSales.map((sale) => toSaleWithProducts(sale, currentEstablishmentId)),
607 │     );
608 │ 
609 │     const totalPages = total === 0 ? 0 : Math.ceil(total / query.limit);
610 │     return {
611 │       sales: salesWithProducts,
612 │       closing,
613 │       pagination: {
614 │         page: query.page,
615 │         limit: query.limit,
616 │         total,
617 │         totalPages,
618 │         hasNextPage: query.page < totalPages,
619 │       },
620 │     };
621 │   }
622 │ 
623 │   async function listSalesByDay(data: string) {
624 │     if (!currentEstablishmentId) return [];
625 │ 
626 │     const query = buildLocalSalesQuery({ dataInicial: data, dataFinal: data }, currentEstablishmentId);
627 │     const sales = await fetchAllSales(query);
628 │     return Promise.all(sales.map((sale) => toSaleWithProducts(sale, currentEstablishmentId)));
629 │   }
