631 │   async function getSalesReportByPeriod(
632 │     startDate: string,
633 │     endDate: string,
634 │     productTypeId?: string | number,
635 │   ) {
636 │     if (!currentEstablishmentId) return [];
637 │ 
638 │     const startPeriod = localPeriodBoundary(startDate, false);
639 │     const endPeriod = localPeriodBoundary(endDate, true);
640 │     if (startPeriod > endPeriod) throw new Error('período inválido');
641 │ 
642 │     const sales = await saleCollection()
643 │       .query(
644 │         Q.where('establishment_id', currentEstablishmentId),
645 │         Q.where('is_cancelled', false),
646 │         Q.where('sold_at', Q.gte(startPeriod)),
647 │         Q.where('sold_at', Q.lte(endPeriod)),
648 │       )
649 │       .fetch();
650 │ 
651 │     const selectedProductType = productTypeId == null ? '' : String(productTypeId).trim();
652 │     const report = new Map<string, { id: string; name: string; price: number; totalVendido: number }>();
653 │ 
654 │     for (const sale of sales) {
655 │       const items = await fetchSaleItems(sale.id, currentEstablishmentId);
656 │       for (const item of items) {
657 │         const product = await findProduct(item.productId, currentEstablishmentId);
658 │         if (!product) continue;
659 │         if (selectedProductType && selectedProductType !== '100'
660 │           && product.productTypeId !== selectedProductType) continue;
661 │ 
662 │         const existing = report.get(product.id);
663 │         if (existing) {
664 │           existing.totalVendido += Number(item.quantity);
665 │         } else {
666 │           report.set(product.id, {
667 │             id: product.id,
668 │             name: product.name,
669 │             price: product.price,
670 │             totalVendido: Number(item.quantity),
671 │           });
672 │         }
673 │       }
674 │     }
675 │ 
676 │     return Array.from(report.values()).sort((a, b) => {
677 │       const quantityDifference = b.totalVendido - a.totalVendido;
678 │       return quantityDifference !== 0 ? quantityDifference : a.id.localeCompare(b.id);
679 │     });
680 │   }
681 │ 
682 │   return {
683 │     createSale,
684 │     createSaleFromOrder,
685 │     createFromOrder: createSaleFromOrder,
686 │     createFromSync,
687 │     removeSale,
688 │     listRecentSales,
689 │     getSaleById,
690 │     listSalesByDay,
691 │     getSalesReportByPeriod,
692 │     /** @deprecated Use the English sale methods. */
693 │     createVenda: createSale,
694 │     createVendaDoPedido: createSaleFromOrder,
695 │     removeVenda: removeSale,
696 │     listVendasRecentes: listRecentSales,
697 │     getVendaById: getSaleById,
698 │     listVendasPorDia: listSalesByDay,
699 │     getRelatorioPorPeriodo: getSalesReportByPeriod,
700 │   };
701 │ }

