170 │ async function ensureRootChangesBelongToEstablishment(
171 │   changes: SyncChangeSet,
172 │   tableName: 'products' | 'orders' | 'sales',
173 │   establishmentId: string,
174 │ ): Promise<void> {
175 │   const records = rawRecords(changes, tableName);
176 │   if (records.length === 0) return;
177 │ 
178 │   const localRecords = await recordsByIds(
179 │     tableName,
180 │     records.map((record) => String(record.id)),
181 │   );
182 │   const localRecordsById = new Map(localRecords.map((record) => [String(record.id), record]));
183 │ 
184 │   // Check the local row even when the incoming payload has a scope. An ID
185 │   // collision must not let a remote row replace another tenant's local row.
186 │   for (const record of localRecords) {
187 │     ensureRecordBelongsToEstablishment(tableName, record, establishmentId);
188 │   }
189 │ 
190 │   for (const record of records) {
191 │     if (!Object.prototype.hasOwnProperty.call(record, 'establishment_id')
192 │       && !localRecordsById.has(String(record.id))) {
193 │       throw new Error(`[sync] ${tableName} record has no establishment_id`);
194 │     }
195 │   }
196 │ }
