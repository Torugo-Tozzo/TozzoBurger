257 │   async function createFromSync(data: OrderData & { items?: OrderItemData[] }) {
258 │     if (!currentEstablishmentId) {
259 │       throw new Error('Cannot sync an order without an authenticated establishment');
260 │     }
261 │ 
262 │     const raw = data as unknown as OrderSyncInput;
263 │     const incomingEstablishmentId = normalizeEstablishmentId(
264 │       raw.establishmentId ?? raw.establishment_id,
265 │     );
266 │     if (incomingEstablishmentId && incomingEstablishmentId !== currentEstablishmentId) {
267 │       throw new Error('Cannot sync an order from another establishment');
268 │     }
269 │ 
270 │     const id = String(raw.id ?? '');
271 │     if (!id) throw new Error('ID inválido');
272 │ 
273 │     const now = Date.now();
274 │     const updatedAt = epoch(raw.updated_at ?? raw.updatedAt, now);
275 │     const createdAt = epoch(raw.created_at, updatedAt);
276 │     const openedAt = epoch(raw.openedAt ?? raw.opened_at, createdAt);
277 │     const isOpen = typeof raw.isOpen === 'boolean'
278 │       ? raw.isOpen
279 │       : typeof raw.is_open === 'boolean'
280 │         ? raw.is_open
281 │         : true;
282 │     const total = Number(raw.total ?? 0);
283 │     const customer = raw.customerName ?? raw.customer_name ?? null;
284 │     const seller = raw.sellerId ?? raw.seller_id ?? raw.createdBy ?? '';
285 │     const items = Array.isArray(raw.items) ? raw.items : [];
286 │ 
287 │     const preparedOrder = orderCollection().prepareCreateFromDirtyRaw({
288 │       id,
289 │       _status: 'synced',
290 │       _changed: '',
291 │       total,
292 │       opened_at: openedAt,
293 │       customer_name: customer,
294 │       is_open: isOpen,
295 │       establishment_id: currentEstablishmentId,
296 │       seller_id: seller == null ? '' : String(seller),
297 │       created_at: createdAt,
298 │       updated_at: updatedAt,
299 │     });
300 │ 
301 │     const preparedItems = items.map((item) => {
302 │       const rawItem = item as OrderItemSyncInput;
303 │       const itemId = rawItem.id ? String(rawItem.id) : generateUUID();
304 │       const itemCreatedAt = epoch(rawItem.created_at, createdAt);
305 │       const itemUpdatedAt = epoch(rawItem.updated_at, updatedAt);
306 │ 
307 │       return orderItemCollection().prepareCreateFromDirtyRaw({
308 │         id: itemId,
309 │         _status: 'synced',
310 │         _changed: '',
311 │         quantity: Number(rawItem.quantity),
312 │         status: orderItemStatus(rawItem.status),
313 │         order_id: id,
314 │         product_id: String(rawItem.productId ?? rawItem.product_id ?? ''),
315 │         unit_price_at_order: Number(rawItem.unitPriceAtOrder ?? rawItem.unit_price_at_order ?? 0),
316 │         created_at: itemCreatedAt,
317 │         updated_at: itemUpdatedAt,
318 │       });
319 │     });
320 │ 
321 │     await database.write(() => database.batch(preparedOrder, ...preparedItems));
322 │     markChanged('orders');
323 │     return { orderId: id };
324 │   }
