365 │ function isSyncConflictError(error: unknown): boolean {
366 │   if (!isRecord(error)) return false;
367 │ 
368 │   if (error.status === 409) return true;
369 │   if (error.code === 'SYNC_CONFLICT' || error.error === 'SYNC_CONFLICT') return true;
370 │ 
371 │   const body = isRecord(error.body) ? error.body : null;
372 │   return body?.code === 'SYNC_CONFLICT' || body?.error === 'SYNC_CONFLICT';
373 │ }
