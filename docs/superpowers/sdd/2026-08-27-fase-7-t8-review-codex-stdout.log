375 │ /**
376 │  * Creates the callback consumed by WatermelonDB's native synchronize().
377 │  * The API already returns Watermelon raw records, so this boundary only
378 │  * normalizes the fixed table set and rejects records from another tenant.
379 │  */
380 │ export function pullChanges(
381 │   token: string,
382 │   establishmentId?: EstablishmentId,
383 │   onPulledChanges?: OnPulledChanges,
384 │ ): (args: SyncPullArgs) => Promise<SyncPullResult> {
385 │   return async ({ lastPulledAt, schemaVersion }: SyncPullArgs) => {
386 │     const response = await api.pullChanges(token, { lastPulledAt, schemaVersion });
387 │     const changes = normalizeChangeSet(response?.changes, establishmentId);
388 │     const timestamp = normalizeTimestamp(response?.timestamp);
389 │     await ensureTenantScope(changes, establishmentId);
390 │     onPulledChanges?.(changes);
391 │     return { changes, timestamp };
392 │   };
393 │ }
394 │ 
395 │ /**
396 │  * Creates the callback consumed by WatermelonDB's native synchronize().
397 │  * A 409 is intentionally allowed to reject this promise; the caller retries
398 │  * the complete native synchronization cycle when it is a sync conflict.
399 │  */
400 │ export function pushChanges(
401 │   token: string,
402 │   establishmentId?: EstablishmentId,
403 │ ): (args: SyncPushArgs) => Promise<void> {
404 │   return async ({ changes, lastPulledAt }: SyncPushArgs) => {
405 │     const normalizedChanges = normalizeChangeSet(changes, establishmentId);
406 │     await ensureTenantScope(normalizedChanges, establishmentId);
407 │     const response = await api.pushChanges(token, {
408 │       changes: normalizedChanges,
409 │       lastPulledAt,
410 │     });
411 │     reportIgnoredPushItems(response);
412 │   };
413 │ }
414 │ 
415 │ /**
416 │  * Runs one complete Watermelon pull/apply/push cycle. Callers must invoke
417 │  * this function through database/syncGuard.runWithLock.
418 │  */
419 │ export async function synchronizeWithServer(
420 │   token: string,
421 │   establishmentId?: EstablishmentId,
422 │ ): Promise<void> {
423 │   let attempt = 0;
424 │ 
425 │   while (true) {
426 │     attempt += 1;
427 │     let pulledChanges: SyncChangeSet | null = null;
428 │ 
429 │     try {
430 │       await watermelonSynchronize({
431 │         database,
432 │         pullChanges: pullChanges(token, establishmentId, (changes) => {
433 │           pulledChanges = changes;
434 │         }),
435 │         pushChanges: pushChanges(token, establishmentId),
436 │         migrationsEnabledAtVersion: 1,
437 │         onDidPullChanges: async () => {
438 │           if (pulledChanges) markPulledTables(pulledChanges);
439 │         },
440 │       });
441 │       return;
442 │     } catch (error) {
443 │       if (!isSyncConflictError(error) || attempt >= MAX_SYNC_ATTEMPTS) {
444 │         throw error;
445 │       }
446 │     }
447 │   }
448 │ }
449 │ 
450 │ export default synchronizeWithServer;

