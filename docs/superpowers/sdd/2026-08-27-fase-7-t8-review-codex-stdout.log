221 │     );
222 │     const sellerId = createdBy == null ? '' : String(createdBy);
223 │ 
224 │     const order = await database.write(async () => {
225 │       const createdOrder = await orderCollection().create((record) => {
226 │         record.total = total;
227 │         record.openedAt = now;
228 │         record.customerName = customerName ?? null;
229 │         record.isOpen = isOpen;
230 │         record.establishmentId = currentEstablishmentId;
231 │         record.sellerId = sellerId;
232 │         record.createdAt = now;
233 │         record.updatedAt = now;
234 │       });
235 │ 
236 │       const itemsCollection = orderItemCollection();
237 │       for (const [index, item] of items.entries()) {
238 │         await itemsCollection.create((record) => {
239 │           record.quantity = Number(item.quantity);
240 │           record.status = ORDER_ITEM_STATUS.REQUESTED;
241 │           record.orderId = createdOrder.id;
242 │           record.order.set(createdOrder);
243 │           record.productId = String(item.productId);
244 │           record.unitPriceAtOrder = prices[index];
245 │           record.createdAt = now;
246 │           record.updatedAt = now;
247 │         });
