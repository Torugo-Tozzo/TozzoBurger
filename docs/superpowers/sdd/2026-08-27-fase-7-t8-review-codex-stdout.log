326 │   async function getOrderById(orderId: string) {
327 │     const order = await findOrder(String(orderId), currentEstablishmentId);
328 │ 
329 │     if (!order) throw new Error(`Pedido com ID ${orderId} não encontrado.`);
330 │ 
331 │     const items = await fetchOrderItems(order.id, currentEstablishmentId!);
332 │     return {
333 │       ...toOrderData(order),
334 │       items: items.map(toOrderItemData),
335 │     };
