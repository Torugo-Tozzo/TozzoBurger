278 │ async function fetchSalesPage(
279 │   query: LocalSalesQuery,
280 │   page: number,
281 │   limit: number,
282 │ ): Promise<SaleModel[]> {
283 │   return saleCollection()
284 │     .query(
285 │       ...query.baseClauses,
