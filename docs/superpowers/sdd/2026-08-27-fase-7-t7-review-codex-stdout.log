519 │     getOrderById,
520 │     getProductsByOrderId,
521 │     updateOrder,
522 │     removeOrder,
523 │     listRecentOrders,
524 │     listOrdersByDay,
525 │     listRecentOrdersByUser,
526 │     countOpenOrders,
527 │     /** @deprecated Use the English order methods. */
528 │     createPedido: createOrder,
529 │     getPedidoById: getOrderById,
530 │     getProdutosByPedidoId: getProductsByOrderId,
531 │     updatePedido: updateOrder,
