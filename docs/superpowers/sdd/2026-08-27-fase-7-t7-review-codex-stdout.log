533 │     listPedidosRecentes: listRecentOrders,
534 │     listPedidosPorDia: listOrdersByDay,
535 │     listPedidosRecentesPorUsuario: listRecentOrdersByUser,
536 │     countPedidosAbertos: countOpenOrders,
537 │   };
538 │ }
