222 │   const parsed = toFiniteNumber(value, Number.NaN);
223 │   return Number.isFinite(parsed) ? parsed : undefined;
224 │ }
225 │ 
226 │ function normalizeSoldAt(value: string | number | Date): string {
227 │   if (value instanceof Date) return value.toISOString();
228 │   if (typeof value === 'number') return new Date(value).toISOString();
229 │   return String(value);
230 │ }
231 │ 
232 │ export function mapSaleApiToRender(sale: SaleApi): SaleRenderable {
233 │   const items = (sale.items ?? []).map((item) => {
234 │     const quantity = toFiniteNumber(item.quantity);
235 │     const price = toFiniteNumber(item.unitPriceAtSale ?? item.product?.price);
236 │     const name = nonEmptyString(item.product?.name) ?? 'Unknown product';
237 │     const productId = item.productId ?? item.product?.id;
238 │     return {
239 │       id: item.id == null ? undefined : String(item.id),
240 │       productId: productId == null ? undefined : String(productId),
241 │       name,
242 │       quantity,
243 │       price,
244 │       subtotal: price * quantity,
245 │     };
246 │   });
247 │   return {
248 │     id: String(sale.id),
249 │     total: toFiniteNumber(sale.total),
250 │     soldAt: normalizeSoldAt(sale.soldAt),
251 │     customerName: sale.customerName == null ? null : String(sale.customerName),
252 │     isCancelled: sale.isCancelled === true,
253 │     createdBy: sale.seller?.id == null ? null : String(sale.seller.id),
254 │     createdByName: sale.seller?.name == null ? null : String(sale.seller.name),
255 │     products: items.map((item) => `( ${item.quantity}x ) ${item.name}`),
256 │     items,
257 │   };
258 │ }
259 │ 
260 │ function minutesFromTime(value: string | null | undefined): number | undefined {
261 │   const time = parseTime(value);
262 │   return time ? time[0] * 60 + time[1] : undefined;
263 │ }
264 │ 
265 │ function localDateFromValue(value: string | number | Date): Date | undefined {
266 │   const date = value instanceof Date ? new Date(value.getTime()) : new Date(value);
267 │   return Number.isNaN(date.getTime()) ? undefined : date;
268 │ }
269 │ 
270 │ export type LocalSaleFilterable = { total: number; soldAt: string | number | Date; customerName?: string | null };
271 │ 
272 │ export function filterLocalSales<T extends LocalSaleFilterable>(sales: T[], filters: SalesFilters = {}): T[] {
273 │   const inicio = dateBoundary(filters.dataInicial, filters.horaInicial, false);
274 │   const fim = dateBoundary(filters.dataFinal, filters.horaFinal, true);
275 │   const inicioMs = inicio ? new Date(inicio).getTime() : undefined;
276 │   const fimMs = fim ? new Date(fim).getTime() : undefined;
277 │   const horaInicial = minutesFromTime(filters.horaInicial);
278 │   const horaFinal = minutesFromTime(filters.horaFinal);
279 │   const customerName = nonEmptyString(filters.customerName)?.toLocaleLowerCase('pt-BR');
280 │   const totalMin = optionalFilterNumber(filters.totalMin);
281 │   const totalMax = optionalFilterNumber(filters.totalMax);
282 │ 
283 │   return sales.filter((sale) => {
284 │     const soldAt = localDateFromValue(sale.soldAt);
285 │     const soldAtMs = soldAt?.getTime();
286 │     if (inicioMs != null && (soldAtMs == null || soldAtMs < inicioMs)) return false;
287 │     if (fimMs != null && (soldAtMs == null || soldAtMs > fimMs)) return false;
288 │     if (soldAt && (horaInicial != null || horaFinal != null) && inicioMs == null && fimMs == null) {
289 │       const minutos = soldAt.getHours() * 60 + soldAt.getMinutes();
290 │       if (horaInicial != null && minutos < horaInicial) return false;
291 │       if (horaFinal != null && minutos > horaFinal) return false;
292 │     }
293 │     if (customerName && !String(sale.customerName ?? '').toLocaleLowerCase('pt-BR').includes(customerName)) return false;
294 │     const total = toFiniteNumber(sale.total);
295 │     if (totalMin != null && total < totalMin) return false;
296 │     if (totalMax != null && total > totalMax) return false;
297 │     return true;
298 │   });
299 │ }
