   541	  async function listSalesByDay(data: string) {
   542	    if (!currentEstablishmentId) return [];
   543	
   544	    const query = buildLocalSalesQuery({ dataInicial: data, dataFinal: data }, currentEstablishmentId);
   545	    const sales = (await fetchSales(query)).filter((sale) => query.matchesTime(sale.soldAt));
   546	    return Promise.all(sales.map((sale) => toSaleWithProducts(sale, currentEstablishmentId)));
   547	  }
   548	
   549	  async function getSalesReportByPeriod(
   550	    startDate: string,
   551	    endDate: string,
   552	    productTypeId?: string | number,
   553	  ) {
   554	    if (!currentEstablishmentId) return [];
   555	
   556	    const startPeriod = localPeriodBoundary(startDate, false);
   557	    const endPeriod = localPeriodBoundary(endDate, true);
   558	    if (startPeriod > endPeriod) throw new Error('período inválido');
   559	
   560	    const sales = await saleCollection()
   561	      .query(
   562	        Q.where('establishment_id', currentEstablishmentId),
   563	        Q.where('is_cancelled', false),
   564	        Q.where('sold_at', Q.gte(startPeriod)),
   565	        Q.where('sold_at', Q.lte(endPeriod)),
   566	      )
   567	      .fetch();
   568	
   569	    const selectedProductType = productTypeId == null ? '' : String(productTypeId).trim();
   570	    const report = new Map<string, { id: string; name: string; price: number; totalVendido: number }>();
   571	
   572	    for (const sale of sales) {
   573	      const items = await fetchSaleItems(sale.id, currentEstablishmentId);
   574	      for (const item of items) {
   575	        const product = await findProduct(item.productId, currentEstablishmentId);
   576	        if (!product) continue;
   577	        if (selectedProductType && selectedProductType !== '100'
   578	          && product.productTypeId !== selectedProductType) continue;
   579	
   580	        const existing = report.get(product.id);
   581	        if (existing) {
   582	          existing.totalVendido += Number(item.quantity);
   583	        } else {
   584	          report.set(product.id, {
   585	            id: product.id,
   586	            name: product.name,
   587	            price: product.price,
   588	            totalVendido: Number(item.quantity),
   589	          });
   590	        }
   591	      }
   592	    }
   593	
   594	    return Array.from(report.values()).sort((a, b) => {
   595	      const quantityDifference = b.totalVendido - a.totalVendido;
   596	      return quantityDifference !== 0 ? quantityDifference : a.id.localeCompare(b.id);
   597	    });
   598	  }
   599	
   600	  return {
   601	    createSale,
   602	    createSaleFromOrder,
   603	    createFromOrder: createSaleFromOrder,
   604	    createFromSync,
   605	    removeSale,
