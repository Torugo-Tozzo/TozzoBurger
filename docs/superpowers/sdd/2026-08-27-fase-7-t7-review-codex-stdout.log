 95 │ export function withPage(filters: SalesFilters, page: number): SalesFilters {
 96 │   const queryFilters = { ...filters };
 97 │   delete queryFilters.page;
 98 │   delete queryFilters.limit;
 99 │   return { ...queryFilters, page, limit: PAGE_SIZE };
100 │ }
