 73 │ function groupByDate(vendas: SaleRenderable[], locale: string): GroupedSales {
 74 │   return vendas.reduce<GroupedSales>((groups, venda) => {
 75 │     const date = new Date(venda.soldAt).toLocaleDateString(locale);
 76 │     groups[date] = groups[date] ? [...groups[date], venda] : [venda];
 77 │     return groups;
 78 │   }, {});
 79 │ }
