 85 │ function createSalesState(loadingInitial = false): SalesState {
 86 │   return {
 87 │     items: [],
 88 │     total: 0,
 89 │     fechamento: 0,
 90 │     ...resetSalesPageState(),
 91 │     loadingInitial,
 92 │   };
 93 │ }
