   500	  async function listRecentSales(): Promise<RecentSalesGrouped>;
   501	  async function listRecentSales(filters: SalesFilters): Promise<RecentSalesPaginated>;
   502	  async function listRecentSales(filters?: SalesFilters): Promise<RecentSalesGrouped | RecentSalesPaginated> {
   503	    if (!currentEstablishmentId) {
   504	      return filters === undefined ? {} : emptyPaginatedSales(1, DEFAULT_SALES_LIMIT);
   505	    }
   506	
   507	    const query = buildLocalSalesQuery(filters ?? {}, currentEstablishmentId);
   508	    const allMatchingSales = (await fetchSales(query)).filter((sale) => query.matchesTime(sale.soldAt));
   509	    const total = allMatchingSales.length;
   510	    const closing = allMatchingSales.reduce((sum, sale) => sum + sale.total, 0);
   511	    const start = (query.page - 1) * query.limit;
   512	    const pageSales = allMatchingSales.slice(start, start + query.limit);
   513	    const salesWithProducts = await Promise.all(
   514	      pageSales.map((sale) => toSaleWithProducts(sale, currentEstablishmentId)),
   515	    );
   516	
   517	    if (filters === undefined) {
   518	      const salesByDate: RecentSalesGrouped = {};
   519	      for (const sale of salesWithProducts) {
   520	        const date = new Date(sale.soldAt).toLocaleDateString();
   521	        if (!salesByDate[date]) salesByDate[date] = [];
   522	        salesByDate[date].push(sale);
   523	      }
   524	      return salesByDate;
   525	    }
   526	
   527	    const totalPages = total === 0 ? 0 : Math.ceil(total / query.limit);
   528	    return {
   529	      sales: salesWithProducts,
   530	      closing,
   531	      pagination: {
   532	        page: query.page,
   533	        limit: query.limit,
   534	        total,
   535	        totalPages,
   536	        hasNextPage: query.page < totalPages,
   537	      },
   538	    };
   539	  }
