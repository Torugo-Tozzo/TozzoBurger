 61 │ export function canLoadNextPage(
 62 │   state: SalesPageState,
 63 │   inFlight: Pick<InFlightRequest, 'generation'> | null,
 64 │   generation: number,
 65 │ ): boolean {
 66 │   return state.page > 0
 67 │     && !state.loadingInitial
 68 │     && !state.loadingMore
 69 │     && state.hasNextPage
 70 │     && inFlight?.generation !== generation;
 71 │ }
