126 │ function parseDateParts(value: string | null | undefined) {
127 │   const normalized = nonEmptyString(value);
128 │   if (!normalized) return undefined;
129 │   const match = /^(\d{4})-(\d{2})-(\d{2})/.exec(normalized);
130 │   if (!match) return undefined;
131 │   const year = Number(match[1]);
132 │   const month = Number(match[2]);
133 │   const day = Number(match[3]);
134 │   const validationDate = new Date(year, month - 1, day);
135 │   if (validationDate.getFullYear() !== year || validationDate.getMonth() !== month - 1 || validationDate.getDate() !== day) return undefined;
136 │   return { year, month, day };
137 │ }
