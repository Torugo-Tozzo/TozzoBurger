139 │ function parseTime(value: string | null | undefined): [number, number, number, number] | undefined {
140 │   const normalized = nonEmptyString(value);
141 │   if (!normalized) return undefined;
142 │   const match = /^(\d{1,2}):(\d{2})(?::(\d{2}))?$/.exec(normalized);
143 │   if (!match) return undefined;
144 │   const hour = Number(match[1]);
145 │   const minute = Number(match[2]);
146 │   const second = Number(match[3] ?? 0);
147 │   if (hour > 23 || minute > 59 || second > 59) return undefined;
148 │   return [hour, minute, second, 0];
149 │ }
