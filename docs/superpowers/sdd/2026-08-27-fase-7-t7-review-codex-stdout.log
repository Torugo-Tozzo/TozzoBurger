106 │     soldAt: String(venda.soldAt),
107 │     customerName: venda.customerName == null ? null : String(venda.customerName),
108 │     isCancelled: venda.isCancelled === true,
109 │     createdBy: venda.createdBy == null ? null : String(venda.createdBy),
110 │     createdByName: venda.createdByName == null ? null : String(venda.createdByName),
111 │     products: Array.isArray(venda.products) ? venda.products : [],
112 │     items: [],
113 │   };
114 │ }
