   389	  async function createFromSync(data: SaleData & { items?: SaleItemData[]; products?: SaleItemData[] }) {
   390	    if (!currentEstablishmentId) {
   391	      throw new Error('Cannot sync a sale without an authenticated establishment');
   392	    }
   393	
   394	    const raw = data as SaleSyncInput;
   395	    const incomingEstablishmentId = normalizeEstablishmentId(
   396	      raw.establishmentId ?? raw.establishment_id,
   397	    );
   398	    if (incomingEstablishmentId && incomingEstablishmentId !== currentEstablishmentId) {
   399	      throw new Error('Cannot sync a sale from another establishment');
   400	    }
   401	
   402	    const id = String(raw.id ?? '').trim();
   403	    if (!id) throw new Error('ID inválido');
   404	
   405	    const now = Date.now();
   406	    const updatedAt = epoch(raw.updated_at ?? raw.updatedAt, now);
   407	    const createdAt = epoch(raw.created_at, updatedAt);
   408	    const soldAt = epoch(raw.soldAt ?? raw.sold_at, createdAt);
   409	    const seller = raw.sellerId ?? raw.seller_id ?? raw.createdBy ?? '';
   410	    const orderId = raw.orderId ?? raw.order_id ?? null;
   411	    const isCancelled = raw.isCancelled === true || raw.is_cancelled === true;
   412	    const items = Array.isArray(raw.items)
   413	      ? raw.items
   414	      : Array.isArray(raw.products)
   415	        ? raw.products
   416	        : [];
   417	
   418	    const preparedSale = saleCollection().prepareCreateFromDirtyRaw({
   419	      id,
   420	      _status: 'synced',
   421	      _changed: '',
   422	      total: finiteNumber(raw.total),
   423	      sold_at: soldAt,
   424	      customer_name: raw.customerName ?? null,
   425	      is_cancelled: isCancelled,
   426	      establishment_id: currentEstablishmentId,
   427	      seller_id: seller == null ? '' : String(seller),
   428	      order_id: orderId == null ? null : String(orderId),
   429	      created_at: createdAt,
   430	      updated_at: updatedAt,
   431	    });
   432	
   433	    const preparedItems = await Promise.all(items.map(async (item) => {
   434	      const rawItem = item as SaleItemData & {
   435	        product_id?: string;
   436	        unit_price_at_sale?: number;
   437	        created_at?: number | string | Date;
   438	        updated_at?: number | string | Date;
   439	      };
   440	      const incomingProductId = String(rawItem.productId ?? rawItem.product_id ?? '');
   441	      const product = await findProduct(incomingProductId, currentEstablishmentId);
   442	      const itemCreatedAt = epoch(rawItem.created_at, createdAt);
   443	      const itemUpdatedAt = epoch(rawItem.updated_at, updatedAt);
   444	      const unitPriceAtSale = finiteNumber(
   445	        rawItem.unitPriceAtSale ?? rawItem.unit_price_at_sale ?? product?.price,
   446	      );
   447	
   448	      return saleItemCollection().prepareCreateFromDirtyRaw({
   449	        id: rawItem.id ? String(rawItem.id) : generateUUID(),
   450	        _status: 'synced',
   451	        _changed: '',
   452	        quantity: finiteNumber(rawItem.quantity),
   453	        sale_id: id,
   454	        product_id: product?.id ?? incomingProductId,
   455	        unit_price_at_sale: unitPriceAtSale,
   456	        created_at: itemCreatedAt,
   457	        updated_at: itemUpdatedAt,
   458	      });
   459	    }));
   460	
   461	    await database.write(() => database.batch(preparedSale, ...preparedItems));
   462	    markChanged('sales');
   463	    return { saleId: id };
   464	  }
