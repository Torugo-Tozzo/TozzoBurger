    showAdd: mockShowAdd,
    show: jest.fn(),
    searchByName: mockSearchByName,
  }),
}));

jest.mock('@/database/useSaleDatabase', () => ({
  useSaleDatabase: () => ({ createSaleFromOrder: mockCreateSaleFromOrder }),
}));

jest.mock('@/context/AuthContext', () => ({
