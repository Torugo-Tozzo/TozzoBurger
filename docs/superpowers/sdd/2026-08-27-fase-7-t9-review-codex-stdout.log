 34 │ // Prevent the splash screen from auto-hiding before asset loading is complete.
 35 │ SplashScreen.preventAutoHideAsync();
 36 │ 
 37 │ export default function RootLayout() {
 38 │   const [loaded, error] = useFonts({
 39 │     SpaceMono: require('../assets/fonts/SpaceMono-Regular.ttf'),
 40 │     ...FontAwesome.font,
 41 │   });
 42 │   const [i18nInitialized, setI18nInitialized] = useState(false);
 43 │ 
 44 │   useEffect(() => {
 45 │     let mounted = true;
 46 │ 
 47 │     void initializeI18n()
 48 │       .then(() => {
 49 │         if (mounted) setI18nInitialized(true);
 50 │       })
 51 │       .catch((bootstrapError) => {
 52 │         console.warn('Failed to initialize local i18n resources', bootstrapError);
 53 │       });
 54 │ 
 55 │     return () => {
 56 │       mounted = false;
 57 │     };
 58 │   }, []);
 59 │ 
 60 │   // Expo Router uses Error Boundaries to catch errors in the navigation tree.
 61 │   useEffect(() => {
 62 │     if (error) throw error;
 63 │   }, [error]);
 64 │ 
 65 │   useEffect(() => {
 66 │     if (loaded) {
 67 │       SplashScreen.hideAsync();
 68 │     }
 69 │   }, [loaded]);
 70 │ 
 71 │   return (
 72 │     <I18nextProvider i18n={i18n}>
 73 │       {!loaded || !i18nInitialized ? (
 74 │         <AppLoadingScreen stage="initializing" />
 75 │       ) : (
 76 │         <Suspense fallback={<AppLoadingScreen stage="initializing" />}>
 77 │           <SQLiteProvider databaseName="database.db" onInit={initializeDatabase} useSuspense>
 78 │             <AuthProvider>
 79 │               <AutoSyncProvider>
 80 │                 <CartProvider>
 81 │                   <RootLayoutNav />
 82 │                 </CartProvider>
 83 │               </AutoSyncProvider>
 84 │             </AuthProvider>
 85 │           </SQLiteProvider>
 86 │         </Suspense>
 87 │       )}
 88 │     </I18nextProvider>
 89 │   );
 90 │ }
 91 │ 
 92 │ function RootLayoutNav() {
 93 │   const colorScheme = useColorScheme();
 94 │   const { user, loading } = useAuth();
 95 │   const { t } = useTranslation();
 96 │   const router = useRouter();
 97 │   const pathname = usePathname();
 98 │   // Redirect to login or main tabs depending on auth
 99 │   // Use replace so user can't go back to the wrong screen
100 │   useEffect(() => {
101 │     if (loading) return;
102 │     if (!user && pathname !== '/login') {
103 │       (router as any).replace('/login');
104 │       return;
105 │     }
106 │ 
107 │     if (user && pathname === '/login') {
108 │       (router as any).replace('/(tabs)');
109 │     }
110 │   }, [loading, user, router, pathname]);
111 │ 
112 │   if (loading) return <AppLoadingScreen stage={user ? 'preparing' : 'authenticating'} />;
113 │ 
114 │   return (
115 │     <ThemeProvider value={colorScheme === 'dark' ? DarkTheme : DefaultTheme}>
116 │       <StatusBar 
117 │         style={colorScheme === 'dark' ? 'light' : 'dark'} 
118 │         backgroundColor={colorScheme === 'dark' ? '#000' : '#fff'} 
119 │         translucent={true}
120 │       />
121 │       <CategoryOnboardingGate>
122 │         <Stack>
123 │           <Stack.Screen name="login" options={{ headerShown: false }} />
124 │           <Stack.Screen name="(tabs)" options={{ headerShown: false }} />
125 │           <Stack.Screen name="modais/contaModal" options={{ presentation: 'modal', title: t('navigation.account') }} />
126 │           <Stack.Screen name="modais/produtoModal" options={{ presentation: 'modal', title: t('navigation.product') }} />
127 │           <Stack.Screen name="modais/pedidoModal" options={{ presentation: 'modal', title: t('navigation.orders') }} />
128 │           <Stack.Screen name="modais/contaHistoricoModal" options={{ presentation: 'modal', title: t('navigation.closedAccount') }} />
129 │           <Stack.Screen name="modais/adicionalModal" options={{ presentation: 'modal', title: t('navigation.addOn') }} />
130 │           <Stack.Screen name="modais/relatorioModal" options={{ presentation: 'modal', title: t('navigation.report') }} />
131 │         </Stack>
132 │       </CategoryOnboardingGate>
133 │     </ThemeProvider>
134 │   );
135 │ }

