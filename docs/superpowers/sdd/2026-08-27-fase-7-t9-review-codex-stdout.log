377 │  * The API already returns Watermelon raw records, so this boundary only
378 │  * normalizes the fixed table set and rejects records from another tenant.
379 │  */
380 │ export function pullChanges(
381 │   token: string,
382 │   establishmentId?: EstablishmentId,
383 │   onPulledChanges?: OnPulledChanges,
384 │ ): (args: SyncPullArgs) => Promise<SyncPullResult> {
385 │   return async ({ lastPulledAt, schemaVersion }: SyncPullArgs) => {
386 │     const response = await api.pullChanges(token, { lastPulledAt, schemaVersion });
387 │     const changes = normalizeChangeSet(response?.changes, establishmentId);
388 │     const timestamp = normalizeTimestamp(response?.timestamp);
389 │     await ensureTenantScope(changes, establishmentId);
390 │     onPulledChanges?.(changes);
391 │     return { changes, timestamp };
392 │   };
393 │ }
