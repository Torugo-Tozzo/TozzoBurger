242 │ async function ensureProductReferencesBelongToEstablishment(
243 │   changes: SyncChangeSet,
244 │   childTable: 'order_items' | 'sale_items',
245 │   establishmentId: string,
246 │ ): Promise<void> {
247 │   const referenceIds = new Set<string>();
248 │   for (const record of rawRecords(changes, childTable)) {
249 │     const referenceId = record.product_id;
250 │     if (referenceId !== null && referenceId !== undefined && String(referenceId).trim().length > 0) {
251 │       referenceIds.add(String(referenceId));
252 │     }
253 │   }
254 │ 
255 │   const deletedChildren = await recordsByIds(childTable, changes[childTable].deleted);
256 │   for (const record of deletedChildren) {
257 │     const referenceId = record?.productId;
258 │     if (referenceId !== null && referenceId !== undefined && String(referenceId).trim().length > 0) {
259 │       referenceIds.add(String(referenceId));
260 │     }
261 │   }
262 │ 
263 │   if (referenceIds.size === 0) return;
264 │ 
265 │   const incomingProductIds = new Set(rawRecords(changes, 'products').map((record) => String(record.id)));
266 │   const localProductIds = [...referenceIds].filter((id) => !incomingProductIds.has(id));
267 │   const localProducts = await recordsByIds('products', localProductIds);
268 │   const foundLocalProductIds = new Set(localProducts.map((record) => String(record.id)));
269 │ 
270 │   for (const record of localProducts) {
271 │     ensureRecordBelongsToEstablishment('products', record, establishmentId);
272 │   }
273 │ 
274 │   for (const id of localProductIds) {
275 │     if (!foundLocalProductIds.has(id)) {
276 │       throw new Error(`[sync] ${childTable} record references an unknown products record`);
277 │     }
278 │   }
279 │ }
