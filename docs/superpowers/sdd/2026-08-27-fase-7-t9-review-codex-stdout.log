351 │ function reportIgnoredPushItems(response: api.SyncPushResponse | undefined): void {
352 │   const ignored = Array.isArray(response?.ignored) ? response.ignored : [];
353 │   const ignoredOrderDeletes = Array.isArray(response?.ignored_order_deletes)
354 │     ? response.ignored_order_deletes
355 │     : [];
