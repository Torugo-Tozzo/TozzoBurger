 63 │   const { user } = useAuth();
 64 │   const currentEstablishmentId = normalizeEstablishmentId(user?.establishmentId);
 65 │ 
 66 │   async function create(data: Omit<ProductData, 'id' | 'updated_at'>) {
 67 │     const input = data as ProductInput;
 68 │     if (!currentEstablishmentId) {
 69 │       throw new Error('Cannot create a product without an authenticated establishment');
 70 │     }
 71 │ 
 72 │     const now = new Date();
 73 │     const product = await database.write(() => productCollection().create((record) => {
 74 │       record.name = input.name;
 75 │       record.price = input.price;
 76 │       record.productTypeId = input.productTypeId == null ? null : String(input.productTypeId);
 77 │       record.sourceProductId = input.sourceProductId ?? null;
 78 │       record.ingredients = input.ingredients ?? null;
 79 │       record.establishmentId = currentEstablishmentId;
 80 │       record.createdAt = now;
 81 │       record.updatedAt = now;
 82 │     }));
 83 │ 
 84 │     markChanged('products');
 85 │     return { id: product.id };
 86 │   }
 87 │ 
 88 │   async function createFromSync(data: ProductData) {
 89 │     const input = data as ProductInput & { created_at?: number };
 90 │     const updatedAt = Number.isFinite(input.updated_at) ? input.updated_at : Date.now();
 91 │     const createdAt = Number.isFinite(input.created_at) ? input.created_at : updatedAt;
 92 │     const products = productCollection();
 93 │     const preparedProduct = products.prepareCreateFromDirtyRaw({
 94 │       id: input.id,
 95 │       _status: 'synced',
 96 │       _changed: '',
 97 │       name: input.name,
 98 │       price: input.price,
 99 │       product_type_id: input.productTypeId == null ? null : String(input.productTypeId),
100 │       source_product_id: input.sourceProductId ?? null,
101 │       ingredients: input.ingredients ?? null,
102 │       establishment_id: asEstablishmentId(input.establishmentId) || currentEstablishmentId || '',
103 │       created_at: createdAt,
104 │       updated_at: updatedAt,
105 │     });
106 │ 
107 │     await database.write(() => database.batch(preparedProduct));
108 │     markChanged('products');
109 │     return { id: input.id };
110 │   }
111 │ 
112 │   async function searchByName(name: string, limit?: number, offset?: number) {
113 │     if (!currentEstablishmentId) return [];
114 │ 
115 │     const clauses: Clause[] = [
116 │       Q.where('establishment_id', currentEstablishmentId),
117 │       activeProductTypeClause(),
118 │       Q.where('name', Q.like(`%${Q.sanitizeLikeString(name)}%`)),
119 │     ];
120 │ 
121 │     if (limit !== undefined) {
122 │       clauses.push(Q.sortBy('name', Q.asc), Q.sortBy('id', Q.asc), Q.take(limit), Q.skip(offset ?? 0));
123 │     }
124 │ 
125 │     const products = await productCollection().query(...clauses).fetch();
126 │     return products.map(toProductData);
127 │   }
128 │ 
129 │   async function update(data: Omit<ProductData, 'updated_at'>) {
130 │     const product = await findProduct(data.id, currentEstablishmentId);
131 │ 
132 │     if (product) {
133 │       await database.write(() => product.update((record) => {
134 │         record.name = data.name;
135 │         record.price = data.price;
136 │         record.productTypeId = data.productTypeId == null ? null : String(data.productTypeId);
137 │         record.ingredients = data.ingredients ?? null;
138 │       }));
139 │     }
140 │ 
141 │     markChanged('products');
142 │   }
143 │ 
144 │   async function remove(id: string) {
145 │     const product = await findProduct(id, currentEstablishmentId);
146 │ 
147 │     if (product) {
148 │       await database.write(() => product.markAsDeleted());
149 │     }
150 │ 
151 │     markChanged('products');
152 │   }
153 │ 
154 │   async function show(id: string) {
155 │     const product = await findProduct(id, currentEstablishmentId);
156 │     return product ? toProductData(product) : null;
157 │   }
158 │ 
159 │   async function showAdd(id: string) {
160 │     return show(id);
161 │   }
162 │ 
163 │   async function getProductTypes() {
164 │     const productTypes = await database
165 │       .get<ProductTypeModel>('product_types')
166 │       .query(Q.where('is_active', true), Q.sortBy('description', Q.asc))
167 │       .fetch();
168 │ 
169 │     return productTypes.map((productType) => ({
170 │       id: toLegacyNumber(productType.id),
171 │       description: productType.description,
172 │     }));
173 │   }
174 │ 
175 │   async function filterByProductType(productTypeId: number, limit: number, offset: number): Promise<ProductData[]> {
176 │     if (!currentEstablishmentId) return [];
177 │ 
178 │     const products = await productCollection()
179 │       .query(
180 │         Q.where('establishment_id', currentEstablishmentId),
181 │         activeProductTypeClause(),
182 │         Q.where('product_type_id', String(productTypeId)),
183 │         Q.sortBy('name', Q.asc),
184 │         Q.sortBy('id', Q.asc),
185 │         Q.take(limit),
186 │         Q.skip(offset),
187 │       )
188 │       .fetch();
189 │ 
190 │     return products.map(toProductData);
191 │   }
192 │ 
193 │   async function searchBySourceProductId(productId: string): Promise<ProductData[]> {
194 │     if (!currentEstablishmentId) return [];
195 │ 
196 │     const products = await productCollection()
197 │       .query(
198 │         Q.where('establishment_id', currentEstablishmentId),
199 │         activeProductTypeClause(),
200 │         Q.where('source_product_id', productId),
201 │       )
202 │       .fetch();
203 │ 
204 │     return products.map(toProductData);
205 │   }
206 │ 
207 │   return {
208 │     create,
209 │     createFromSync,
210 │     searchByName,
211 │     update,
212 │     remove,
213 │     show,
214 │     getProductTypes,
215 │     filterByProductType,
216 │     searchBySourceProductId,
217 │     /** @deprecated Use getProductTypes. */
218 │     getTipoProdutos: getProductTypes,
219 │     /** @deprecated Use filterByProductType. */
220 │     filterByTipo: filterByProductType,
221 │     /** @deprecated Use searchBySourceProductId. */
222 │     searchOrigemProdutoId: searchBySourceProductId,
223 │     showAdd,
224 │   };
225 │ }

