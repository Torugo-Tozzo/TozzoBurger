+      'order-1',
+      'Cliente',
+      'seller-1',
+      'Caixa',
+    );
+    expect(mockUpdateOrder.mock.invocationCallOrder[0])
+      .toBeLessThan(mockCreateSaleFromOrder.mock.invocationCallOrder[0]);
+  });
+});
