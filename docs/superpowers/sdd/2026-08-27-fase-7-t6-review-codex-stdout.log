272 │     async function getSalesReportByPeriod(
273 │         startDate: string,
274 │         endDate: string,
275 │         productTypeId?: string
276 │     ) {
277 │         try {
278 │             const startDateObj = new Date(startDate);
279 │             startDateObj.setHours(0, 0, 0, 0);
280 │             const startPeriod = startDateObj.toISOString();
281 │             
282 │             // Data final termina à meia-noite do dia seguinte
283 │             const endDateObj = new Date(endDate);
284 │             endDateObj.setHours(23, 59, 59, 999);
285 │             const endPeriod = endDateObj.toISOString();
286 │             
287 │             // Monta a query base usando comparações diretas em vez de BETWEEN
288 │             let query = `
289 │               SELECT 
290 │                 P.id, P.name, P.price, SUM(VP.quantity) as totalVendido
291 │               FROM 
292 │                 RL_SALE_PRODUCT VP
