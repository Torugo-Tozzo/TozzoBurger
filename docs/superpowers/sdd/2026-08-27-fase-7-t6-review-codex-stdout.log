232 │     async function listSalesByDay(data: string) {
233 │         try {
234 │             const inicioDoDia = `${data}T00:00:00.000Z`;
235 │             const fimDoDia = `${data}T23:59:59.999Z`;
236 │     
237 │             const sales = await database.getAllAsync<Sale>(
238 │                 "SELECT * FROM TB_SALES WHERE soldAt BETWEEN ? AND ? AND (deleted_at IS NULL) AND (isCancelled IS NULL OR isCancelled = 0)",
239 │                 [inicioDoDia, fimDoDia]
240 │             );
241 │     
242 │             const salesWithProducts = await Promise.all(
243 │                 sales.map(async (sale) => {
244 │                     const productRows = await database.getAllAsync<{ name: string; quantity: number }>(
245 │                         `SELECT P.name, VP.quantity 
246 │                          FROM RL_SALE_PRODUCT VP
247 │                          JOIN TB_PRODUCTS P ON VP.productId = P.id
248 │                          WHERE VP.saleId = ?`,
249 │                         [sale.id]
250 │                     );
251 │     
252 │                     const productNames = productRows.map(
