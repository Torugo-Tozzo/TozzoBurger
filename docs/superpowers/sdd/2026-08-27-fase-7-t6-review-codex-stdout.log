  3 │ import * as SecureStore from 'expo-secure-store';
  4 │ import { useSQLiteContext } from 'expo-sqlite';
  5 │ import { seedProductType } from '@/database/initializeDatabase';
  6 │ import { synchronizeWithServer } from '@/database/useSyncDatabase';
