187 │                          JOIN TB_PRODUCTS P ON VP.productId = P.id
188 │                          WHERE VP.saleId = ?`,
189 │                         [sale.id]
190 │                     );
191 │     
192 │                     const productNames = productRows.map(
193 │                         (p) => `( ${p.quantity}x ) ${p.name}`
194 │                     );
195 │     
196 │                     // Limita os nomes dos produtos a 3 e adiciona "..." se houver mais
197 │                     const displayedProducts =
198 │                         productNames.length > 3
199 │                             ? [...productNames.slice(0, 3), "..."]
200 │                             : productNames;
201 │     
202 │                     return { ...sale, products: displayedProducts };
203 │                 })
204 │             );
