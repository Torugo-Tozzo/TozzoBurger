170 │ function displayedProducts(products: { name: string; quantity: number }[]): string[] {
171 │   const productNames = products.map((product) => `( ${product.quantity}x ) ${product.name}`);
172 │   return productNames.length > 3
173 │     ? [...productNames.slice(0, 3), '...']
174 │     : productNames;
175 │ }
