 10 │ type User = {
 11 │   id?: number | string;
 12 │   name?: string;
 13 │   email?: string;
 14 │   establishmentId?: number | string | null;
 15 │   role?: string | null;
 16 │ };
 17 │ 
 18 │ type AuthContextData = {
 19 │   user: User | null;
 20 │   token: string | null;
 21 │   loading: boolean;
 22 │   login: (email: string, senha: string) => Promise<boolean>;
 23 │   logout: () => void;
 24 │ };
 25 │ 
 26 │ const AuthContext = createContext<AuthContextData | undefined>(undefined);
 27 │ 
 28 │ export const AuthProvider = ({ children }: { children: ReactNode }) => {
 29 │   const database = useSQLiteContext()
 30 │   const [user, setUser] = useState<User | null>(null);
 31 │   const [token, setToken] = useState<string | null>(null);
 32 │   const [loading, setLoading] = useState<boolean>(true);
 33 │   const TOKEN_KEY = 'tozzo_token_v1';
 34 │ 
 35 │   // Rehydrate token on mount and validate it
 36 │   useEffect(() => {
 37 │     let mounted = true;
 38 │     const load = async () => {
 39 │       try {
 40 │         const stored = await SecureStore.getItemAsync(TOKEN_KEY);
 41 │         if (stored && mounted) {
 42 │           setToken(stored);
 43 │           try {
 44 │             const me = await api.getMe(stored);
 45 │             if (me && mounted) {
 46 │               setUser(me);
 47 │               try {
 48 │                 const schema = await database.getFirstAsync<{ userId?: number | null }>(`SELECT userId FROM TB_SCHEMA LIMIT 1`).catch(() => null);
 49 │                 const userId = schema && typeof schema.userId !== 'undefined' ? schema.userId : null;
 50 │                 if (!userId) {
 51 │                       const uid = Number((me as any).id);
 52 │                       await database.runAsync('UPDATE TB_SCHEMA SET userId = ?', [!isNaN(uid) ? uid : null]);
 53 │                 }
 54 │               } catch (err) {
 55 │                 console.warn('Failed to run seedProdutosPadrao after rehydrate', err);
 56 │               }
 57 │             }
 58 │           } catch (err: any) {
 59 │             // Only clear token on explicit auth errors (401/402/403).
 60 │             // For network/server errors (offline) keep the stored token.
 61 │             const status = err?.response?.status ?? err?.status ?? null;
 62 │             if (status === 401 || status === 402 || status === 403) {
 63 │               console.warn('Stored token invalid, clearing', err);
 64 │               await SecureStore.deleteItemAsync(TOKEN_KEY);
 65 │               if (mounted) {
 66 │                 setToken(null);
 67 │                 setUser(null);
 68 │               }
 69 │             } else {
 70 │               console.warn('Network/server error validating token — keeping stored token', err);
 71 │               try {
 72 │                 const prev = await database.getFirstAsync<{
 73 │                   id?: number;
 74 │                   name?: string;
 75 │                   email?: string;
 76 │                   establishmentId?: number | string; establishmentName?: string;
 77 │                   role?: string | null;
 78 │                 }>(`SELECT id, name, email, establishmentId, establishmentName, role FROM TB_USERS LIMIT 1`).catch(() => null);
 79 │                 if (prev && mounted) {
 80 │                   setUser({
 81 │                     id: prev.id,
 82 │                     name: prev.name,
 83 │                     email: prev.email,
 84 │                     establishmentId: prev.establishmentId,
 85 │                     role: prev.role ?? 'EMPLOYEE',
 86 │                   });
 87 │                 }
 88 │               } catch (e) {
 89 │                 console.warn('Failed to load local TB_USERS after network error', e);
 90 │               }
 91 │             }
 92 │           }
 93 │         }
 94 │       } catch (err) {
 95 │         console.warn('Failed to load token from SecureStore', err);
 96 │       } finally {
 97 │         if (mounted) setLoading(false);
 98 │       }
 99 │     };
100 │ 
101 │     load();
102 │     return () => {
103 │       mounted = false;
104 │     };
105 │   }, []);
106 │ 
107 │   const login = async (email: string, senha: string) => {
108 │     setLoading(true);
109 │     try {
110 │       const body = await api.login(email, senha);
111 │       // Expect the API to return an object that includes a token string.
112 │       // Common keys: token, accessToken. Try both.
113 │       const t = body?.token ?? body?.accessToken ?? body?.access_token ?? null;
114 │       if (!t) return false;
115 │       try {
116 │         await SecureStore.setItemAsync(TOKEN_KEY, t);
117 │       } catch (err) {
118 │         console.warn('Failed to persist token to SecureStore', err);
119 │       }
120 │ 
121 │       // Fetch user profile
122 │       try {
123 │         const me = await api.getMe(t);
124 │         if (!me) {
125 │           console.warn('Failed to fetch /usuarios/me: empty profile');
126 │           return false;
127 │         }
128 │         setUser(me);
129 │ 
130 │         try {
131 │           const prev = await database.getFirstAsync<{ id?: number; email?: string; establishmentId?: string }>(`SELECT id, email, establishmentId FROM TB_USERS LIMIT 1`).catch(() => null);
132 │           const meId = (me as any)?.id;
133 │           const meEmail = (me as any)?.email ?? null;
134 │           const meEstab = (me as any)?.establishmentId ?? null;
135 │           const meRole = (me as any)?.role ?? 'EMPLOYEE';
136 │           const meNome = (me as any)?.name ?? null;
137 │           const meNomeEstab = (me as any)?.establishmentName ?? null;
138 │           const meIdNum = isNaN(Number(meId)) ? null : Number(meId);
139 │ 
140 │           const insertUser = async () => {
141 │             await database.execAsync('DELETE FROM TB_USERS;');
142 │             await database.runAsync(
143 │               'INSERT INTO TB_USERS (name, email, establishmentId, establishmentName, role) VALUES (?, ?, ?, ?, ?)',
144 │               [meNome, meEmail, meEstab, meNomeEstab, meRole]
145 │             );
146 │           };
147 │ 
148 │           if (!prev) {
149 │             await insertUser();
150 │             await database.runAsync('UPDATE TB_SCHEMA SET userId = ?, establishmentId = ?', [meIdNum, meEstab]).catch((e) => console.warn('[auth] db op failed', e));
151 │             await seedProductType(database).catch((e) => console.warn('[auth] db op failed', e));
152 │           } else {
153 │             if (String(prev.establishmentId) !== String(meEstab)) {
154 │               try {
155 │                 await database.execAsync('BEGIN;');
156 │                 const deletes = [
157 │                   'DELETE FROM RL_SALE_PRODUCT;',
158 │                   'DELETE FROM RL_ORDER_PRODUCT;',
159 │                   'DELETE FROM TB_PRODUCTS;',
160 │                   'DELETE FROM TB_PRODUCT_TYPES;',
161 │                   'DELETE FROM TB_SALES;',
162 │                   'DELETE FROM TB_ORDERS;',
163 │                   'DELETE FROM TB_PRINTERS;'
164 │                 ];
165 │                 for (const d of deletes) {
166 │                   await database.execAsync(d).catch((e) => console.warn('[auth] db op failed', e));
167 │                 }
168 │                 await database.execAsync('DELETE FROM TB_USERS;').catch((e) => console.warn('[auth] db op failed', e));
169 │                 await database.runAsync(
170 │                   'INSERT INTO TB_USERS (name, email, establishmentId, establishmentName, role) VALUES (?, ?, ?, ?, ?)',
171 │                   [meNome, meEmail, meEstab, meNomeEstab, meRole]
172 │                 ).catch((e) => console.warn('[auth] db op failed', e));
173 │                 await database.runAsync('UPDATE TB_SCHEMA SET userId = ?, establishmentId = ?', [meIdNum, meEstab]).catch((e) => console.warn('[auth] db op failed', e));
174 │                 await database.execAsync('COMMIT;');
175 │ 
176 │                 await resetWatermelonLocalData().catch((e) => console.warn('[auth] Watermelon local data reset failed', e));
177 │               } catch (err) {
178 │                 await database.execAsync('ROLLBACK;').catch((e) => console.warn('[auth] db op failed', e));
179 │                 console.warn('Failed during destructive swap; rolled back', err);
180 │               }
181 │ 
182 │                 await seedProductType(database).catch((e) => console.warn('[auth] db op failed', e));
183 │             } else {
184 │               await database.execAsync('DELETE FROM TB_USERS;').catch((e) => console.warn('[auth] db op failed', e));
185 │               await database.runAsync(
186 │                 'INSERT INTO TB_USERS (name, email, establishmentId, establishmentName, role) VALUES (?, ?, ?, ?, ?)',
187 │                 [meNome, meEmail, meEstab, meNomeEstab, meRole]
188 │               ).catch((e) => console.warn('[auth] db op failed', e));
189 │               await database.runAsync('UPDATE TB_SCHEMA SET userId = ?', [meIdNum]).catch((e) => console.warn('[auth] db op failed', e));
190 │             }
191 │           }
192 │         } catch (err) {
193 │           console.warn('Failed to check/replace TB_USERS on login', err);
194 │         }
195 │         setToken(t);
196 │         // The first sync must not block navigation. The list screens show their
197 │         // skeletons while this background sync populates the local database.
198 │         void runWithLock(() => synchronizeWithServer(database, t))
199 │           .then((res) => {
200 │             if (res === null) console.log('[sync] skipped login-triggered sync; another sync is in progress');
201 │           })
202 │           .catch((err) => console.warn('sync after login failed', err));
203 │         
204 │       } catch (err) {
205 │         console.warn('Failed to fetch /usuarios/me', err);
206 │         return false;
207 │       }
208 │ 
209 │       return true;
210 │     } catch (err) {
211 │       console.warn('Login failed', err);
212 │       return false;
213 │     } finally {
214 │       setLoading(false);
215 │     }
216 │   };
217 │ 
218 │   const logout = () => {
219 │     setToken(null);
220 │     setUser(null);
221 │     SecureStore.deleteItemAsync(TOKEN_KEY).catch((err) => console.warn('Failed to delete token', err));
222 │   };
223 │ 
224 │   return (
225 │     <AuthContext.Provider value={{ user, token, loading, login, logout }}>
226 │       {children}
227 │     </AuthContext.Provider>
228 │   );
229 │ };
230 │ 
231 │ export const useAuth = () => {
232 │   const ctx = useContext(AuthContext);
233 │   if (!ctx) throw new Error('useAuth must be used within AuthProvider');
234 │   return ctx;
235 │ };
236 │ 
237 │ export default AuthContext;

