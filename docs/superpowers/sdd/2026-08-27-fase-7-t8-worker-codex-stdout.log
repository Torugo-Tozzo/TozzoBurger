   118	export async function login(email: string, password: string) {
   119	  const url = `${BASE_URL}/auth/login`;
   120	  try {
   121	    const res = await fetch(url, {
   122	      method: 'POST',
   123	      headers: { 'Content-Type': 'application/json', Accept: 'application/json', ...NGROK_HEADERS },
   124	      body: JSON.stringify({ email, senha: password }),
   125	    });
   126	
   127	    if (!res.ok) {
   128	      const errBody = await handleJsonResponse(res).catch(() => null);
   129	      const message = (errBody && (errBody.message || JSON.stringify(errBody))) || `HTTP ${res.status}`;
   130	      console.error('API login error:', url, message);
   131	      throw new Error(message);
   132	    }
   133	
   134	    const body = await handleJsonResponse(res);
   135	    return body && typeof body === 'object' ? { ...body, user: body.user ? fromLegacyUser(body.user) : body.user } : body;
   136	  } catch (err: any) {
   137	    console.error('Network/login request failed', url, err?.message ?? err);
   138	    throw err;
   139	  }
   140	}
