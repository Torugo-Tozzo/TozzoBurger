   104	function readTotalCountHeader(res: Response): number | undefined {
   105	  const headers = (res as Response & { headers?: { get?: (name: string) => string | null } }).headers;
   106	  const value = headers?.get?.('X-Total-Count');
   107	  return nonNegativeInteger(value);
