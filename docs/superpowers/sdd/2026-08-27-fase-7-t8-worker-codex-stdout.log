    60	    const message = typeof record?.message === 'string'
    61	      ? record.message
    62	      : typeof body === 'string' && body.trim().length > 0
    63	        ? body
    64	        : fallbackMessage;
    65	    super(message);
    66	    this.name = 'ApiHttpError';
    67	    this.status = status;
    68	    this.body = body;
