+
+async function ensureDeletedRootsBelongToEstablishment(
+  tableName: 'products' | 'orders' | 'sales',
+  ids: string[],
+  establishmentId: string,
+): Promise<void> {
+  const records = await recordsByIds(tableName, ids);
+  for (const record of records) {
