   323	export function pullChanges(
   324	  token: string,
   325	  establishmentId?: EstablishmentId,
   326	  onPulledChanges?: OnPulledChanges,
   327	): (args: SyncPullArgs) => Promise<SyncPullResult> {
   328	  return async ({ lastPulledAt, schemaVersion }: SyncPullArgs) => {
   329	    const response = await api.pullChanges(token, { lastPulledAt, schemaVersion });
   330	    const changes = normalizeChangeSet(response?.changes, establishmentId);
   331	    const timestamp = normalizeTimestamp(response?.timestamp);
   332	    await ensureTenantScope(changes, establishmentId);
   333	    onPulledChanges?.(changes);
   334	    return { changes, timestamp };
   335	  };
   336	}
