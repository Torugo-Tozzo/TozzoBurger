              await database.runAsync(
                'UPDATE TB_PRODUCTS SET name = ?, productTypeId = ?, price = ?, sourceProductId = ?, ingredients = ?, updated_at = ?, deleted_at = ?, sync_status = ? WHERE id = ?',
