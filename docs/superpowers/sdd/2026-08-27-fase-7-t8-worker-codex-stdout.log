+export type WatermelonSyncTableChangeSet = {
+  created: unknown[];
+  updated: unknown[];
+  deleted: string[];
+};
+
+export type WatermelonSyncChangeSet = Record<string, WatermelonSyncTableChangeSet>;
+
+export type SyncPullRequest = {
+  lastPulledAt?: number | null;
+  schemaVersion: number;
+};
+
