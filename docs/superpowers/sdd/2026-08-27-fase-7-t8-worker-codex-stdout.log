   235	
   236	    const body = await handleJsonResponse(res);
   237	    const normalized = fromLegacySyncResponse({ vendas: Array.isArray(body?.sales) ? body.sales : body?.vendas ?? [] });
   238	    const sales = normalized.sales ?? [];
   239	    const pagination = validPagination(body?.pagination);
   240	    return {
