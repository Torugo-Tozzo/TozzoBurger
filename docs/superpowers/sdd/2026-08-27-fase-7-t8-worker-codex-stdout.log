   110	function fallbackSalesPagination(res: Response, filters: SalesFilters, receivedCount: number): SalesPagination {
   111	  const page = positiveInteger(filters.page, DEFAULT_SALES_PAGE);
   112	  const limit = positiveInteger(filters.limit, DEFAULT_SALES_LIMIT);
   113	  const total = readTotalCountHeader(res) ?? receivedCount;
   114	  const totalPages = Math.ceil(total / limit);
   115	  return { page, limit, total, totalPages, hasNextPage: page < totalPages };
   116	}
