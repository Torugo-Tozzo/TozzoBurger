+
+async function ensureRootChangesBelongToEstablishment(
+  changes: SyncChangeSet,
+  tableName: 'products' | 'orders' | 'sales',
+  establishmentId: string,
+): Promise<void> {
+  const records = rawRecords(changes, tableName);
+  if (records.length === 0) return;
