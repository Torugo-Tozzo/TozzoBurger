    88	function validPagination(value: unknown): SalesPagination | undefined {
    89	  if (!value || typeof value !== 'object') return undefined;
    90	  const pagination = value as Partial<Record<keyof SalesPagination, unknown>>;
    91	  const page = integerAtLeast(pagination.page, 1);
    92	  const limit = integerAtLeast(pagination.limit, 1);
    93	  const total = integerAtLeast(pagination.total, 0);
    94	  const totalPages = integerAtLeast(pagination.totalPages, 0);
    95	  if (page == null || limit == null || total == null || totalPages == null || typeof pagination.hasNextPage !== 'boolean') return undefined;
    96	  return { page, limit, total, totalPages, hasNextPage: pagination.hasNextPage };
