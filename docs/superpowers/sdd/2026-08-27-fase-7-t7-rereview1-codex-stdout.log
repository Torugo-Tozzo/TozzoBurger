199 │   appendParam(params, 'dataFinal', dataFinal ? dateBoundary(dataFinal, filters.horaFinal, true) ?? dataFinal : undefined);
200 │   appendParam(params, 'horaInicial', filters.horaInicial);
201 │   appendParam(params, 'horaFinal', filters.horaFinal);
202 │   if (nonEmptyString(filters.horaInicial) || nonEmptyString(filters.horaFinal)) {
203 │     appendParam(params, 'timezoneOffsetMinutes', parseTimezoneOffsetMinutes(filters.timezoneOffsetMinutes));
204 │   }
205 │   appendParam(params, 'customerName', filters.customerName);
206 │   appendParam(params, 'totalMin', filters.totalMin);
207 │   appendParam(params, 'totalMax', filters.totalMax);
208 │   return params;
