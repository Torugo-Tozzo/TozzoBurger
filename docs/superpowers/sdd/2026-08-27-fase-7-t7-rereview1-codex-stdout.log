220 │ function optionalFilterNumber(value: number | string | null | undefined): number | undefined {
221 │   if (value == null || (typeof value === 'string' && value.trim() === '')) return undefined;
222 │   const parsed = toFiniteNumber(value, Number.NaN);
223 │   return Number.isFinite(parsed) ? parsed : undefined;
224 │ }
