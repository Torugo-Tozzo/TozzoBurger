159 │ function appendParam(params: URLSearchParams, name: string, value: string | number | null | undefined): void {
160 │   if (value == null) return;
161 │   const normalized = typeof value === 'string' ? value.trim() : String(value);
162 │   if (normalized.length > 0) params.set(name, normalized);
163 │ }
