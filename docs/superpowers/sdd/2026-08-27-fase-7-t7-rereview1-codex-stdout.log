597 │   async function listSalesByDay(data: string) {
598 │     if (!currentEstablishmentId) return [];
599 │ 
600 │     const query = buildLocalSalesQuery({ dataInicial: data, dataFinal: data }, currentEstablishmentId);
601 │     const sales = await fetchAllSales(query);
602 │     return Promise.all(sales.map((sale) => toSaleWithProducts(sale, currentEstablishmentId)));
603 │   }
604 │ 
605 │   async function getSalesReportByPeriod(
606 │     startDate: string,
607 │     endDate: string,
608 │     productTypeId?: string | number,
609 │   ) {
610 │     if (!currentEstablishmentId) return [];
611 │ 
612 │     const startPeriod = localPeriodBoundary(startDate, false);
613 │     const endPeriod = localPeriodBoundary(endDate, true);
614 │     if (startPeriod > endPeriod) throw new Error('período inválido');
615 │ 
616 │     const sales = await saleCollection()
617 │       .query(
618 │         Q.where('establishment_id', currentEstablishmentId),
619 │         Q.where('is_cancelled', false),
620 │         Q.where('sold_at', Q.gte(startPeriod)),
621 │         Q.where('sold_at', Q.lte(endPeriod)),
622 │       )
623 │       .fetch();
624 │ 
625 │     const selectedProductType = productTypeId == null ? '' : String(productTypeId).trim();
626 │     const report = new Map<string, { id: string; name: string; price: number; totalVendido: number }>();
627 │ 
628 │     for (const sale of sales) {
629 │       const items = await fetchSaleItems(sale.id, currentEstablishmentId);
630 │       for (const item of items) {
631 │         const product = await findProduct(item.productId, currentEstablishmentId);
632 │         if (!product) continue;
633 │         if (selectedProductType && selectedProductType !== '100'
634 │           && product.productTypeId !== selectedProductType) continue;
635 │ 
636 │         const existing = report.get(product.id);
637 │         if (existing) {
638 │           existing.totalVendido += Number(item.quantity);
639 │         } else {
640 │           report.set(product.id, {
641 │             id: product.id,
642 │             name: product.name,
643 │             price: product.price,
644 │             totalVendido: Number(item.quantity),
645 │           });
646 │         }
647 │       }
648 │     }
649 │ 
650 │     return Array.from(report.values()).sort((a, b) => {
651 │       const quantityDifference = b.totalVendido - a.totalVendido;
652 │       return quantityDifference !== 0 ? quantityDifference : a.id.localeCompare(b.id);
653 │     });
654 │   }
655 │ 
656 │   return {
657 │     createSale,
658 │     createSaleFromOrder,
659 │     createFromOrder: createSaleFromOrder,
660 │     createFromSync,
661 │     removeSale,
662 │     listRecentSales,
663 │     getSaleById,
664 │     listSalesByDay,
665 │     getSalesReportByPeriod,
666 │     /** @deprecated Use the English sale methods. */
667 │     createVenda: createSale,
668 │     createVendaDoPedido: createSaleFromOrder,
669 │     removeVenda: removeSale,
670 │     listVendasRecentes: listRecentSales,
671 │     getVendaById: getSaleById,
672 │     listVendasPorDia: listSalesByDay,
673 │     getRelatorioPorPeriodo: getSalesReportByPeriod,
674 │   };
675 │ }

