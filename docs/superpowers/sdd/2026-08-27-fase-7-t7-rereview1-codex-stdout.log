 91 │ export function mergeSalesPage(existing: SaleRenderable[], incoming: SaleRenderable[], page: number): SaleRenderable[] {
 92 │   const merged: SaleRenderable[] = [];
 93 │   const indexes = new Map<string, number>();
 94 │ 
 95 │   if (page !== 1) {
 96 │     existing.forEach((sale) => {
 97 │       if (indexes.has(sale.id)) return;
 98 │       indexes.set(sale.id, merged.length);
 99 │       merged.push(sale);
100 │     });
101 │   }
102 │ 
103 │   incoming.forEach((sale) => {
104 │     const existingIndex = indexes.get(sale.id);
105 │     if (existingIndex === undefined) {
106 │       indexes.set(sale.id, merged.length);
107 │       merged.push(sale);
108 │     } else {
109 │       merged[existingIndex] = sale;
110 │     }
111 │   });
112 │ 
113 │   return merged;
114 │ }
