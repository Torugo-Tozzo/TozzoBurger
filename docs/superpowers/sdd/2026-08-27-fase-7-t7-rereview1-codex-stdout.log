120 │ function nonEmptyString(value: string | null | undefined): string | undefined {
121 │   if (value == null) return undefined;
122 │   const normalized = value.trim();
123 │   return normalized.length > 0 ? normalized : undefined;
124 │ }
125 │ 
126 │ function parseDateParts(value: string | null | undefined) {
127 │   const normalized = nonEmptyString(value);
128 │   if (!normalized) return undefined;
129 │   const match = /^(\d{4})-(\d{2})-(\d{2})/.exec(normalized);
130 │   if (!match) return undefined;
131 │   const year = Number(match[1]);
132 │   const month = Number(match[2]);
133 │   const day = Number(match[3]);
134 │   const validationDate = new Date(year, month - 1, day);
135 │   if (validationDate.getFullYear() !== year || validationDate.getMonth() !== month - 1 || validationDate.getDate() !== day) return undefined;
136 │   return { year, month, day };
137 │ }
138 │ 
139 │ function parseTime(value: string | null | undefined): [number, number, number, number] | undefined {
140 │   const normalized = nonEmptyString(value);
141 │   if (!normalized) return undefined;
142 │   const match = /^(\d{1,2}):(\d{2})(?::(\d{2}))?$/.exec(normalized);
143 │   if (!match) return undefined;
144 │   const hour = Number(match[1]);
145 │   const minute = Number(match[2]);
146 │   const second = Number(match[3] ?? 0);
147 │   if (hour > 23 || minute > 59 || second > 59) return undefined;
148 │   return [hour, minute, second, 0];
149 │ }
150 │ 
151 │ function dateBoundary(dateValue: string | null | undefined, timeValue: string | null | undefined, endOfDay: boolean): string | undefined {
152 │   const date = parseDateParts(dateValue);
153 │   if (!date) return undefined;
154 │   const time = parseTime(timeValue);
155 │   const [hour, minute, second, millisecond] = time ?? (endOfDay ? [23, 59, 59, 999] : [0, 0, 0, 0]);
156 │   return new Date(date.year, date.month - 1, date.day, hour, minute, second, millisecond).toISOString();
157 │ }
