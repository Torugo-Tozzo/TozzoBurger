458 │     const startOfDay = new Date(`${data}T00:00:00.000Z`).getTime();
459 │     const endOfDay = new Date(`${data}T23:59:59.999Z`).getTime();
460 │     const orders = await orderCollection()
461 │       .query(
462 │         Q.where('establishment_id', currentEstablishmentId),
463 │         Q.where('is_open', true),
464 │         Q.where('opened_at', Q.gte(startOfDay)),
465 │         Q.where('opened_at', Q.lte(endOfDay)),
466 │         Q.sortBy('opened_at', Q.desc),
467 │         Q.sortBy('id', Q.desc),
468 │       )
469 │       .fetch();
470 │ 
471 │     return Promise.all(orders.map((order) => toOrderWithProducts(order, currentEstablishmentId!)));
472 │   }
