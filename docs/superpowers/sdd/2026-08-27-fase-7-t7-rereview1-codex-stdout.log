165 │ export function parseTimezoneOffsetMinutes(value: SalesFilters['timezoneOffsetMinutes']): number {
166 │   const fallback = new Date().getTimezoneOffset();
167 │   const normalized = value == null || (typeof value === 'string' && value.trim() === '')
168 │     ? fallback
169 │     : typeof value === 'string'
170 │       ? Number(value.trim())
171 │       : value;
172 │ 
173 │   if (
174 │     !Number.isInteger(normalized) ||
175 │     normalized < MIN_TIMEZONE_OFFSET_MINUTES ||
176 │     normalized > MAX_TIMEZONE_OFFSET_MINUTES
177 │   ) {
178 │     throw new Error('timezoneOffsetMinutes inválido');
179 │   }
180 │ 
181 │   return normalized;
182 │ }
