257 │   async function createFromSync(data: OrderData & { items?: OrderItemData[] }) {
258 │     if (!currentEstablishmentId) {
259 │       throw new Error('Cannot sync an order without an authenticated establishment');
260 │     }
261 │ 
262 │     const raw = data as unknown as OrderSyncInput;
263 │     const incomingEstablishmentId = normalizeEstablishmentId(
264 │       raw.establishmentId ?? raw.establishment_id,
265 │     );
266 │     if (incomingEstablishmentId && incomingEstablishmentId !== currentEstablishmentId) {
267 │       throw new Error('Cannot sync an order from another establishment');
268 │     }
269 │ 
270 │     const id = String(raw.id ?? '');
271 │     if (!id) throw new Error('ID inválido');
272 │ 
273 │     const now = Date.now();
274 │     const updatedAt = epoch(raw.updated_at ?? raw.updatedAt, now);
275 │     const createdAt = epoch(raw.created_at, updatedAt);
276 │     const openedAt = epoch(raw.openedAt ?? raw.opened_at, createdAt);
277 │     const isOpen = typeof raw.isOpen === 'boolean'
278 │       ? raw.isOpen
279 │       : typeof raw.is_open === 'boolean'
280 │         ? raw.is_open
281 │         : true;
282 │     const total = Number(raw.total ?? 0);
283 │     const customer = raw.customerName ?? raw.customer_name ?? null;
284 │     const seller = raw.sellerId ?? raw.seller_id ?? raw.createdBy ?? '';
285 │     const items = Array.isArray(raw.items) ? raw.items : [];
286 │ 
287 │     const preparedOrder = orderCollection().prepareCreateFromDirtyRaw({
288 │       id,
289 │       _status: 'synced',
290 │       _changed: '',
291 │       total,
292 │       opened_at: openedAt,
293 │       customer_name: customer,
294 │       is_open: isOpen,
295 │       establishment_id: currentEstablishmentId,
296 │       seller_id: seller == null ? '' : String(seller),
297 │       created_at: createdAt,
298 │       updated_at: updatedAt,
299 │     });
300 │ 
301 │     const preparedItems = items.map((item) => {
302 │       const rawItem = item as OrderItemSyncInput;
303 │       const itemId = rawItem.id ? String(rawItem.id) : generateUUID();
304 │       const itemCreatedAt = epoch(rawItem.created_at, createdAt);
305 │       const itemUpdatedAt = epoch(rawItem.updated_at, updatedAt);
306 │ 
307 │       return orderItemCollection().prepareCreateFromDirtyRaw({
308 │         id: itemId,
309 │         _status: 'synced',
310 │         _changed: '',
311 │         quantity: Number(rawItem.quantity),
312 │         status: orderItemStatus(rawItem.status),
313 │         order_id: id,
314 │         product_id: String(rawItem.productId ?? rawItem.product_id ?? ''),
315 │         unit_price_at_order: Number(rawItem.unitPriceAtOrder ?? rawItem.unit_price_at_order ?? 0),
316 │         created_at: itemCreatedAt,
317 │         updated_at: itemUpdatedAt,
318 │       });
319 │     });
320 │ 
321 │     await database.write(() => database.batch(preparedOrder, ...preparedItems));
322 │     markChanged('orders');
323 │     return { orderId: id };
324 │   }
325 │ 
326 │   async function getOrderById(orderId: string) {
327 │     const order = await findOrder(String(orderId), currentEstablishmentId);
328 │ 
329 │     if (!order) throw new Error(`Pedido com ID ${orderId} não encontrado.`);
330 │ 
331 │     const items = await fetchOrderItems(order.id, currentEstablishmentId!);
332 │     return {
333 │       ...toOrderData(order),
334 │       items: items.map(toOrderItemData),
335 │     };
336 │   }
337 │ 
338 │   async function updateOrder(
339 │     orderId: string,
340 │     items?: OrderItemData[],
341 │     customerName?: string,
342 │     isOpen?: boolean,
343 │   ) {
344 │     if (typeof isOpen !== 'undefined' && typeof isOpen !== 'boolean') {
345 │       throw new Error('isOpen inválido');
346 │     }
347 │ 
348 │     const order = await findOrder(String(orderId), currentEstablishmentId);
349 │     if (!order) {
350 │       // Keep the old no-op behavior for an unknown ID while ensuring an ID
351 │       // from another establishment cannot be mutated.
352 │       markChanged('orders');
353 │       return;
354 │     }
355 │ 
356 │     const hasItemsUpdate = Array.isArray(items);
357 │     const existingItems = hasItemsUpdate
358 │       ? await fetchOrderItems(order.id, currentEstablishmentId!)
359 │       : [];
360 │     const prices = hasItemsUpdate
361 │       ? await Promise.all(items!.map((item) => productPrice(String(item.productId), currentEstablishmentId!)))
362 │       : [];
363 │     const total = hasItemsUpdate
364 │       ? items!.reduce((sum, item, index) => sum + prices[index] * Number(item.quantity), 0)
365 │       : order.total;
366 │     const existingByProduct = new Map<string, OrderItemModel[]>();
367 │ 
368 │     for (const existingItem of existingItems) {
369 │       const key = String(existingItem.productId);
370 │       const group = existingByProduct.get(key) ?? [];
371 │       group.push(existingItem);
372 │       existingByProduct.set(key, group);
373 │     }
374 │ 
375 │     const usedItems = new Set<string>();
376 │     const now = new Date();
377 │ 
378 │     await database.write(async () => {
379 │       if (hasItemsUpdate) {
380 │         const itemsCollection = orderItemCollection();
381 │ 
382 │         for (const [index, item] of items!.entries()) {
383 │           const key = String(item.productId);
384 │           const existingItem = existingByProduct.get(key)?.shift();
385 │           const nextStatus = item.status == null ? undefined : orderItemStatus(item.status);
386 │ 
387 │           if (existingItem) {
388 │             usedItems.add(existingItem.id);
389 │             await existingItem.update((record) => {
390 │               record.quantity = Number(item.quantity);
391 │               if (nextStatus) record.status = nextStatus;
392 │               record.updatedAt = now;
393 │             });
394 │           } else {
395 │             await itemsCollection.create((record) => {
396 │               record.quantity = Number(item.quantity);
397 │               record.status = nextStatus ?? ORDER_ITEM_STATUS.REQUESTED;
398 │               record.orderId = order.id;
399 │               record.order.set(order);
400 │               record.productId = key;
401 │               record.unitPriceAtOrder = prices[index];
402 │               record.createdAt = now;
403 │               record.updatedAt = now;
404 │             });
405 │           }
406 │         }
407 │ 
408 │         for (const existingItem of existingItems) {
409 │           if (!usedItems.has(existingItem.id)) await existingItem.markAsDeleted();
410 │         }
411 │       }
412 │ 
413 │       if (hasItemsUpdate || typeof customerName !== 'undefined' || typeof isOpen !== 'undefined') {
414 │         await order.update((record) => {
415 │           if (hasItemsUpdate) record.total = total;
416 │           if (typeof customerName !== 'undefined') record.customerName = customerName ?? null;
417 │           if (typeof isOpen !== 'undefined') record.isOpen = isOpen;
418 │           record.updatedAt = now;
419 │         });
420 │       }
421 │     });
422 │ 
423 │     markChanged('orders');
424 │   }
