192 │ export function buildSalesQueryParams(filters: SalesFilters = {}): URLSearchParams {
193 │   const params = new URLSearchParams();
194 │   appendParam(params, 'page', filters.page);
195 │   appendParam(params, 'limit', filters.limit);
196 │   const dataInicial = nonEmptyString(filters.dataInicial);
197 │   const dataFinal = nonEmptyString(filters.dataFinal);
