131 │ async function productPrice(productId: string, establishmentId: string): Promise<number> {
132 │   const product = await findProduct(productId, establishmentId);
133 │   return product?.price ?? 0;
134 │ }
135 │ 
136 │ async function calculateTotal(items: OrderItemData[], establishmentId: string): Promise<number> {
137 │   const prices = await Promise.all(
138 │     items.map((item) => productPrice(String(item.productId), establishmentId)),
139 │   );
140 │ 
141 │   return items.reduce(
142 │     (total, item, index) => total + prices[index] * Number(item.quantity),
143 │     0,
144 │   );
145 │ }
146 │ 
147 │ async function fetchOrderItems(orderId: string, establishmentId: string): Promise<OrderItemModel[]> {
148 │   return orderItemCollection()
149 │     .query(
150 │       Q.where('order_id', orderId),
151 │       Q.on('orders', Q.where('establishment_id', establishmentId)),
152 │     )
153 │     .fetch();
154 │ }
