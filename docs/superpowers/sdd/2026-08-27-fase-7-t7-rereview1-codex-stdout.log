156 │ async function productNamesForItems(
157 │   items: OrderItemModel[],
158 │   establishmentId: string,
159 │ ): Promise<{ name: string; quantity: number }[]> {
160 │   const rows = await Promise.all(
161 │     items.map(async (item) => {
162 │       const product = await findProduct(item.productId, establishmentId);
163 │       return product ? { name: product.name, quantity: item.quantity } : null;
164 │     }),
165 │   );
166 │ 
167 │   return rows.filter((row): row is { name: string; quantity: number } => row !== null);
168 │ }
