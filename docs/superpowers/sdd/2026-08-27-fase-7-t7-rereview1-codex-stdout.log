555 │   async function listRecentSales(): Promise<RecentSalesGrouped>;
556 │   async function listRecentSales(filters: SalesFilters): Promise<RecentSalesPaginated>;
557 │   async function listRecentSales(filters?: SalesFilters): Promise<RecentSalesGrouped | RecentSalesPaginated> {
558 │     if (!currentEstablishmentId) {
559 │       return filters === undefined ? {} : emptyPaginatedSales(1, DEFAULT_SALES_LIMIT);
560 │     }
561 │ 
562 │     const query = buildLocalSalesQuery(filters ?? {}, currentEstablishmentId);
563 │     if (filters === undefined) {
564 │       const groupedSales = await fetchAllSales(query);
565 │       const salesWithProducts = await Promise.all(
566 │         groupedSales.map((sale) => toSaleWithProducts(sale, currentEstablishmentId)),
567 │       );
568 │       const salesByDate: RecentSalesGrouped = {};
569 │       for (const sale of salesWithProducts) {
570 │         const date = new Date(sale.soldAt).toLocaleDateString();
571 │         if (!salesByDate[date]) salesByDate[date] = [];
572 │         salesByDate[date].push(sale);
573 │       }
574 │       return salesByDate;
575 │     }
576 │ 
577 │     const pageSales = (await fetchSales(query)).filter((sale) => query.matchesTime(sale.soldAt));
578 │     const { total, closing } = await summarizeSales(query);
579 │     const salesWithProducts = await Promise.all(
580 │       pageSales.map((sale) => toSaleWithProducts(sale, currentEstablishmentId)),
581 │     );
582 │ 
583 │     const totalPages = total === 0 ? 0 : Math.ceil(total / query.limit);
584 │     return {
585 │       sales: salesWithProducts,
586 │       closing,
587 │       pagination: {
588 │         page: query.page,
589 │         limit: query.limit,
590 │         total,
591 │         totalPages,
592 │         hasNextPage: query.page < totalPages,
593 │       },
594 │     };
595 │   }
