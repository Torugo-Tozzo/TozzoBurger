540 │   async function removeSale(saleId: string) {
541 │     if (!currentEstablishmentId) return;
542 │ 
543 │     const sale = await findSale(String(saleId), currentEstablishmentId);
544 │     if (sale) {
545 │       const now = new Date();
546 │       await database.write(() => sale.update((record) => {
