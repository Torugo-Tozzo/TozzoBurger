184 │ export function timezoneOffsetToSqliteModifier(timezoneOffsetMinutes: number): string {
185 │   const sign = timezoneOffsetMinutes > 0 ? '-' : '+';
186 │   const absolute = Math.abs(timezoneOffsetMinutes);
187 │   const hours = Math.floor(absolute / 60);
188 │   const minutes = absolute % 60;
189 │   return `${sign}${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}`;
190 │ }
