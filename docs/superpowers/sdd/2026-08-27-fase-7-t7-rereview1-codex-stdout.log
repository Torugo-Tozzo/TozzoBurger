177 │ async function toOrderWithProducts(
178 │   order: OrderModel,
179 │   establishmentId: string,
180 │ ): Promise<OrderWithProducts> {
181 │   const items = await fetchOrderItems(order.id, establishmentId);
182 │   const products = await productNamesForItems(items, establishmentId);
183 │   return { ...toOrderData(order), products: displayedProducts(products) };
184 │ }
185 │ 
186 │ function groupOrdersByDate(orders: OrderWithProducts[]): Record<string, OrderWithProducts[]> {
187 │   const ordersByDate: Record<string, OrderWithProducts[]> = {};
188 │ 
189 │   for (const order of orders) {
190 │     const date = new Date(order.openedAt).toLocaleDateString();
191 │     if (!ordersByDate[date]) ordersByDate[date] = [];
192 │     ordersByDate[date].push(order);
193 │   }
194 │ 
195 │   return ordersByDate;
196 │ }
