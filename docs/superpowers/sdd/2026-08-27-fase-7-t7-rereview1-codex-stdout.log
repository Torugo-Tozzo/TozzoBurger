317 │ export function useSaleDatabase() {
318 │   const { user } = useAuth();
319 │   const currentEstablishmentId = normalizeEstablishmentId(user?.establishmentId);
320 │ 
321 │   async function createSale(
322 │     items: SaleItemInput[],
323 │     customerName?: string,
324 │     createdBy?: string | number | null,
325 │     createdByName?: string | null,
326 │   ) {
327 │     if (!currentEstablishmentId) {
328 │       throw new Error('Cannot create a sale without an authenticated establishment');
329 │     }
330 │ 
331 │     const products = await Promise.all(items.map(async (item) => {
332 │       const product = await findProduct(String(item.productId), currentEstablishmentId);
333 │       if (!product) throw new Error(`Produto ${item.productId} não encontrado`);
334 │       return { item, product };
335 │     }));
336 │     const total = products.reduce(
337 │       (sum, { item, product }) => sum + product.price * Number(item.quantity),
338 │       0,
339 │     );
340 │     const now = new Date();
341 │     const sellerId = createdBy == null ? '' : String(createdBy);
342 │ 
343 │     const sale = await database.write(async () => {
344 │       const createdSale = await saleCollection().create((record) => {
345 │         record.total = total;
346 │         record.soldAt = now;
347 │         record.customerName = customerName ?? null;
348 │         record.createdByName = createdByName ?? null;
349 │         record.isCancelled = false;
350 │         record.establishmentId = currentEstablishmentId;
351 │         record.sellerId = sellerId;
352 │         record.orderId = null;
353 │         record.createdAt = now;
354 │         record.updatedAt = now;
355 │       });
356 │ 
357 │       for (const { item, product } of products) {
358 │         await saleItemCollection().create((record) => {
359 │           record.quantity = Number(item.quantity);
360 │           record.saleId = createdSale.id;
361 │           record.sale.set(createdSale);
362 │           record.productId = product.id;
363 │           record.product.set(product);
364 │           record.unitPriceAtSale = product.price;
365 │           record.createdAt = now;
366 │           record.updatedAt = now;
367 │         });
368 │       }
369 │ 
370 │       return createdSale;
371 │     });
372 │ 
373 │     markChanged('sales');
374 │     return { saleId: sale.id };
375 │   }
376 │ 
377 │   async function createSaleFromOrder(
378 │     orderId: string,
379 │     customerName?: string | null,
380 │     createdBy?: string | number | null,
381 │     createdByName?: string | null,
382 │   ) {
383 │     if (!currentEstablishmentId) {
384 │       throw new Error('Cannot create a sale without an authenticated establishment');
385 │     }
386 │ 
387 │     const sale = await database.write(async () => {
388 │       const order = await findOrder(String(orderId), currentEstablishmentId);
389 │       if (!order) throw new Error(`Pedido com ID ${orderId} não encontrado.`);
390 │       if (!order.isOpen) throw new Error(`Pedido com ID ${orderId} já está fechado.`);
391 │ 
392 │       const items = await fetchOrderItems(order.id, currentEstablishmentId);
393 │       const products = await Promise.all(items.map(async (item) => {
394 │         const product = await findProduct(item.productId, currentEstablishmentId);
395 │         if (!product) throw new Error(`Produto ${item.productId} não encontrado`);
396 │         return { item, product };
397 │       }));
398 │       const now = new Date();
399 │       const sellerId = order.sellerId || (createdBy == null ? '' : String(createdBy));
400 │ 
401 │       const createdSale = await saleCollection().create((record) => {
402 │         record.total = order.total;
403 │         record.soldAt = now;
404 │         record.customerName = customerName === undefined ? order.customerName : customerName;
405 │         record.createdByName = createdByName ?? null;
406 │         record.isCancelled = false;
407 │         record.establishmentId = currentEstablishmentId;
408 │         record.sellerId = sellerId;
409 │         record.orderId = order.id;
410 │         record.createdAt = now;
411 │         record.updatedAt = now;
412 │       });
413 │ 
414 │       for (const { item, product } of products) {
415 │         const unitPriceAtSale = Number.isFinite(item.unitPriceAtOrder)
416 │           ? item.unitPriceAtOrder
417 │           : product.price;
418 │         await saleItemCollection().create((record) => {
419 │           record.quantity = item.quantity;
420 │           record.saleId = createdSale.id;
421 │           record.sale.set(createdSale);
422 │           record.productId = product.id;
423 │           record.product.set(product);
424 │           record.unitPriceAtSale = unitPriceAtSale;
425 │           record.createdAt = now;
426 │           record.updatedAt = now;
427 │         });
428 │       }
429 │ 
430 │       await order.update((record) => {
431 │         record.isOpen = false;
432 │         record.updatedAt = now;
433 │       });
434 │ 
435 │       return createdSale;
436 │     });
437 │ 
438 │     markChanged('sales');
439 │     markChanged('orders');
440 │     return { saleId: sale.id };
441 │   }
442 │ 
443 │   async function createFromSync(data: SaleSyncInput) {
444 │     if (!currentEstablishmentId) {
445 │       throw new Error('Cannot sync a sale without an authenticated establishment');
446 │     }
447 │ 
448 │     const raw = data as SaleSyncInput;
449 │     const incomingEstablishmentId = normalizeEstablishmentId(
450 │       raw.establishmentId ?? raw.establishment_id,
451 │     );
452 │     if (incomingEstablishmentId && incomingEstablishmentId !== currentEstablishmentId) {
453 │       throw new Error('Cannot sync a sale from another establishment');
454 │     }
455 │ 
456 │     const id = String(raw.id ?? '').trim();
457 │     if (!id) throw new Error('ID inválido');
458 │ 
459 │     const now = Date.now();
460 │     const updatedAt = epoch(raw.updated_at ?? raw.updatedAt, now);
461 │     const createdAt = epoch(raw.created_at, updatedAt);
462 │     const soldAt = epoch(raw.soldAt ?? raw.sold_at, createdAt);
463 │     const seller = raw.sellerId ?? raw.seller_id ?? raw.createdBy ?? '';
464 │     const orderId = raw.orderId ?? raw.order_id ?? null;
465 │     const isCancelled = raw.isCancelled === true || raw.is_cancelled === true;
466 │     const items = Array.isArray(raw.items)
467 │       ? raw.items
468 │       : Array.isArray(raw.products)
469 │         ? raw.products
470 │         : [];
471 │ 
472 │     const preparedSale = saleCollection().prepareCreateFromDirtyRaw({
473 │       id,
474 │       _status: 'synced',
475 │       _changed: '',
476 │       total: finiteNumber(raw.total),
477 │       sold_at: soldAt,
478 │       customer_name: raw.customerName ?? null,
479 │       created_by_name: raw.createdByName ?? raw.created_by_name ?? null,
480 │       is_cancelled: isCancelled,
481 │       establishment_id: currentEstablishmentId,
482 │       seller_id: seller == null ? '' : String(seller),
483 │       order_id: orderId == null ? null : String(orderId),
484 │       created_at: createdAt,
485 │       updated_at: updatedAt,
486 │     });
487 │ 
488 │     const preparedItems = await Promise.all(items.map(async (item) => {
489 │       const rawItem = item as SaleItemData & {
490 │         product_id?: string;
491 │         unit_price_at_sale?: number;
492 │         created_at?: number | string | Date;
493 │         updated_at?: number | string | Date;
494 │       };
495 │       const incomingProductId = String(rawItem.productId ?? rawItem.product_id ?? '');
496 │       const product = await findProduct(incomingProductId, currentEstablishmentId);
497 │       const itemCreatedAt = epoch(rawItem.created_at, createdAt);
498 │       const itemUpdatedAt = epoch(rawItem.updated_at, updatedAt);
499 │       const unitPriceAtSale = finiteNumber(
500 │         rawItem.unitPriceAtSale ?? rawItem.unit_price_at_sale ?? product?.price,
501 │       );
502 │ 
503 │       return saleItemCollection().prepareCreateFromDirtyRaw({
504 │         id: rawItem.id ? String(rawItem.id) : generateUUID(),
505 │         _status: 'synced',
506 │         _changed: '',
507 │         quantity: finiteNumber(rawItem.quantity),
508 │         sale_id: id,
509 │         product_id: product?.id ?? incomingProductId,
510 │         unit_price_at_sale: unitPriceAtSale,
511 │         created_at: itemCreatedAt,
512 │         updated_at: itemUpdatedAt,
513 │       });
514 │     }));
515 │ 
516 │     await database.write(() => database.batch(preparedSale, ...preparedItems));
517 │     markChanged('sales');
518 │     return { saleId: id };
519 │   }
520 │ 
521 │   async function getSaleById(saleId: string) {
522 │     if (!currentEstablishmentId) {
523 │       throw new Error(`Venda com ID ${saleId} não encontrada.`);
524 │     }
525 │ 
526 │     const sale = await findSale(String(saleId), currentEstablishmentId);
527 │     if (!sale) throw new Error(`Venda com ID ${saleId} não encontrada.`);
528 │ 
529 │     const [items, createdByName] = await Promise.all([
530 │       fetchSaleItems(sale.id, currentEstablishmentId),
531 │       createdByNameForSale(sale, currentEstablishmentId),
532 │     ]);
