+    expect(JSON.stringify(query.clauses)).toEqual(expect.stringContaining('is_cancelled'));
+  });
+
+  it('matches local sale hours with the requested timezone offset', () => {
+    const query = buildLocalSalesQuery({
+      horaInicial: '20:00',
+      horaFinal: '22:00',
