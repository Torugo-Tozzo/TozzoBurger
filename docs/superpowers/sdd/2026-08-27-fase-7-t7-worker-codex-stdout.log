+const mockMarkChanged = markChanged as jest.Mock;
+const mockUseAuth = useAuth as jest.MockedFunction<typeof useAuth>;
+
+function makeDatabase() {
+  const adapter = new SQLiteAdapter({
+    schema,
+    migrations,
+    dbName: ':memory:',
+    jsi: true,
+    onSetUpError: (error) => {
+      throw error;
+    },
+  });
+
+  return new Database({ adapter, modelClasses });
+}
+
+function setCurrentEstablishment(establishmentId: string | number | null) {
+  mockUseAuth.mockReturnValue({
+    user: { establishmentId },
+  } as ReturnType<typeof useAuth>);
+}
+
+async function seedProduct(
+  database: Database,
+  data: { id: string; name: string; price: number; establishmentId: string; productTypeId?: string },
+) {
+  const now = new Date('2026-08-20T09:00:00.000Z');
+  return database.write(() => database.get<Product>('products').create((product) => {
+    product.id = data.id;
+    product.name = data.name;
+    product.price = data.price;
+    product.productTypeId = data.productTypeId ?? null;
+    product.sourceProductId = null;
+    product.ingredients = null;
+    product.establishmentId = data.establishmentId;
+    product.createdAt = now;
+    product.updatedAt = now;
+  }));
+}
+
+async function seedOrder(
+  database: Database,
+  data: {
+    id: string;
+    establishmentId: string;
+    total: number;
+    customerName?: string | null;
+    sellerId?: string;
+    openedAt?: Date;
+    items: { productId: string; quantity: number; status: 'REQUESTED' | 'IN_PREPARATION' | 'DELIVERED'; unitPriceAtOrder: number }[];
+  },
+) {
+  const now = data.openedAt ?? new Date('2026-08-20T10:00:00.000Z');
+  return database.write(async () => {
+    const order = await database.get<Order>('orders').create((record) => {
+      record.id = data.id;
+      record.total = data.total;
+      record.openedAt = now;
+      record.customerName = data.customerName ?? null;
+      record.isOpen = true;
+      record.establishmentId = data.establishmentId;
+      record.sellerId = data.sellerId ?? '';
+      record.createdAt = now;
+      record.updatedAt = now;
+    });
+
+    for (const item of data.items) {
+      await database.get<OrderItem>('order_items').create((record) => {
+        record.quantity = item.quantity;
+        record.status = item.status;
+        record.orderId = order.id;
+        record.order.set(order);
+        record.productId = item.productId;
+        record.unitPriceAtOrder = item.unitPriceAtOrder;
+        record.createdAt = now;
+        record.updatedAt = now;
+      });
+    }
+
+    return order;
+  });
+}
+
+async function seedSale(
+  database: Database,
+  data: {
+    id: string;
+    establishmentId: string;
+    soldAt: Date;
+    total: number;
+    productId: string;
+    quantity: number;
+    unitPriceAtSale: number;
+    customerName?: string | null;
+  },
+) {
+  return database.write(async () => {
+    const sale = await database.get<Sale>('sales').create((record) => {
+      record.id = data.id;
+      record.total = data.total;
+      record.soldAt = data.soldAt;
+      record.customerName = data.customerName ?? null;
+      record.isCancelled = false;
+      record.establishmentId = data.establishmentId;
+      record.sellerId = '';
+      record.orderId = null;
+      record.createdAt = data.soldAt;
+      record.updatedAt = data.soldAt;
+    });
+
+    await database.get<SaleItem>('sale_items').create((record) => {
+      record.quantity = data.quantity;
+      record.saleId = sale.id;
+      record.sale.set(sale);
+      record.productId = data.productId;
+      record.unitPriceAtSale = data.unitPriceAtSale;
+      record.createdAt = data.soldAt;
+      record.updatedAt = data.soldAt;
+    });
+
+    return sale;
+  });
+}
