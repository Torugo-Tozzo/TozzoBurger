+  const items = data.items.map((item) => database.get<OrderItem>('order_items').prepareCreateFromDirtyRaw({
+    id: `${data.id}-${item.productId}-${item.quantity}`,
+    _status: 'synced',
+    _changed: '',
+    quantity: item.quantity,
+    status: item.status,
+    order_id: data.id,
+    product_id: item.productId,
