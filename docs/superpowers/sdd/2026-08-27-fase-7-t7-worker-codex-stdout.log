197 │ export function localPeriodBoundary(value: string | number | Date, endOfDay: boolean): number {
198 │   const normalized = typeof value === 'string' ? value.trim() : value;
199 │   const date = typeof normalized === 'string' && /^(\d{4})-(\d{2})-(\d{2})$/.test(normalized)
200 │     ? (() => {
201 │       const parsed = parseDate(normalized, 'data');
202 │       return new Date(parsed.year, parsed.month - 1, parsed.day);
203 │     })()
204 │     : normalized instanceof Date ? new Date(normalized.getTime()) : new Date(normalized);
205 │   if (!Number.isFinite(date.getTime())) throw new Error('período inválido');
206 │ 
207 │   date.setHours(endOfDay ? 23 : 0, endOfDay ? 59 : 0, endOfDay ? 59 : 0, endOfDay ? 999 : 0);
208 │   return date.getTime();
209 │ }
