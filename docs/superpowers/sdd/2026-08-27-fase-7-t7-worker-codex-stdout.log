+    createSale,
+    createSaleFromOrder,
+    createFromOrder: createSaleFromOrder,
+    createFromSync,
+    removeSale,
+    listRecentSales,
+    getSaleById,
+    listSalesByDay,
+    getSalesReportByPeriod,
