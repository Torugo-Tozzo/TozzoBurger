  });

  it('não inicia próxima página quando o estado ainda está no reset da consulta', () => {
    expect(canLoadNextPage({
      page: 0,
      hasNextPage: true,
      loadingInitial: false,
      loadingMore: false,
      error: null,
    }, null, 1)).toBe(false);
  });
});

