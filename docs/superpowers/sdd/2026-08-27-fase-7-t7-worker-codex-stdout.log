+      page: 1,
+      limit: 10,
+    })).resolves.toEqual({
+      sales: [expect.objectContaining({
+        id: 'sale-in-period',
+        products: ['( 2x ) X-Salada'],
+      })],
+      closing: 50,
+      pagination: {
