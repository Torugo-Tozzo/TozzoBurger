+          record.saleId = createdSale.id;
+          record.sale.set(createdSale);
+          record.productId = product.id;
+          record.product.set(product);
+          record.unitPriceAtSale = product.price;
+          record.createdAt = now;
+          record.updatedAt = now;
+        });
+      }
