+
+    await expect(mockDatabase.get<Order>('orders').find(order.id)).resolves.toMatchObject({
+      isOpen: false,
+    });
+    const sale = await mockDatabase.get<Sale>('sales').find(result.saleId);
+    expect(sale).toMatchObject({
