+        if (!product) throw new Error(`Produto ${item.productId} não encontrado`);
+        return { item, product };
+      }));
+      const now = new Date();
+      const sellerId = order.sellerId || (createdBy == null ? '' : String(createdBy));
+
+      const createdSale = await saleCollection().create((record) => {
