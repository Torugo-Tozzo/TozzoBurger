      } catch (error) {
        console.error('Erro ao carregar tipos de produtos:', error);
      }
    }
    
    fetchTiposProdutos();
  }, []);
  
  useEffect(() => {
    async function fetchTipoDescricao() {
      if (productTypeId && productTypeId !== 100) {
        try {
          const types = await getProductTypes();
