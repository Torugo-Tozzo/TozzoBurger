+    expect(sale).toMatchObject({
+      total: 51,
+      customerName: 'Ana',
+      establishmentId: 'establishment-1',
+      sellerId: 'seller-1',
+      orderId: order.id,
+      isCancelled: false,
+    });
+
+    const items = await mockDatabase.get<SaleItem>('sale_items')
+      .query(Q.where('sale_id', result.saleId))
