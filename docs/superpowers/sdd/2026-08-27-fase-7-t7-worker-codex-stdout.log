+}
+
+async function fetchSales(query: LocalSalesQuery): Promise<SaleModel[]> {
+  return saleCollection()
+    .query(
+      ...query.clauses,
+      Q.sortBy('sold_at', Q.desc),
+      Q.sortBy('id', Q.desc),
+    )
