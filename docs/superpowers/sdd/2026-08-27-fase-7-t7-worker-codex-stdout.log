+        quantity: finiteNumber(rawItem.quantity),
+        sale_id: id,
+        product_id: product?.id ?? incomingProductId,
+        unit_price_at_sale: unitPriceAtSale,
+        created_at: itemCreatedAt,
+        updated_at: itemUpdatedAt,
