 25 │ function isPedidosPorDataEqual(
 26 │   a: Record<string, OrderWithProducts[]>,
 27 │   b: Record<string, OrderWithProducts[]>
 28 │ ): boolean {
 29 │   const aKeys = Object.keys(a);
 30 │   const bKeys = Object.keys(b);
 31 │   if (aKeys.length !== bKeys.length) return false;
 32 │   for (const key of aKeys) {
 33 │     const aList = a[key];
 34 │     const bList = b[key];
 35 │     if (!bList || aList.length !== bList.length) return false;
 36 │     for (let i = 0; i < aList.length; i++) {
 37 │       if (
 38 │         aList[i].id !== bList[i].id ||
 39 │         aList[i].updated_at !== bList[i].updated_at ||
 40 │         aList[i].isOpen !== bList[i].isOpen
 41 │       ) return false;
 42 │     }
 43 │   }
 44 │   return true;
 45 │ }
