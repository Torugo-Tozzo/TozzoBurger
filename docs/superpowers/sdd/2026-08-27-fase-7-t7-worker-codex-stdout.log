+      Q.on('sales', Q.where('establishment_id', establishmentId)),
+    )
+    .fetch();
+}
+
+async function fetchOrderItems(orderId: string, establishmentId: string): Promise<OrderItemModel[]> {
+  return orderItemCollection()
