+      productId: 'product-1',
+      quantity: 2,
+      unitPriceAtSale: 25,
+    });
+    await seedSale(mockDatabase, {
+      id: 'sale-outside-period',
+      establishmentId: 'establishment-1',
+      soldAt: new Date('2026-08-22T12:00:00.000Z'),
