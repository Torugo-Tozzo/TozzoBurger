496 │   async function listRecentSales(): Promise<RecentSalesGrouped>;
497 │   async function listRecentSales(filters: SalesFilters): Promise<RecentSalesPaginated>;
498 │   async function listRecentSales(filters?: SalesFilters): Promise<RecentSalesGrouped | RecentSalesPaginated> {
499 │     if (!currentEstablishmentId) {
500 │       return filters === undefined ? {} : emptyPaginatedSales(1, 0);
501 │     }
502 │ 
503 │     const query = buildLocalSalesQuery(filters ?? {}, currentEstablishmentId);
504 │     const allMatchingSales = (await fetchSales(query)).filter((sale) => query.matchesTime(sale.soldAt));
505 │     const total = allMatchingSales.length;
506 │     const closing = allMatchingSales.reduce((sum, sale) => sum + sale.total, 0);
507 │     const start = (query.page - 1) * query.limit;
508 │     const pageSales = allMatchingSales.slice(start, start + query.limit);
509 │     const salesWithProducts = await Promise.all(
510 │       pageSales.map((sale) => toSaleWithProducts(sale, currentEstablishmentId)),
511 │     );
512 │ 
513 │     if (filters === undefined) {
514 │       const salesByDate: RecentSalesGrouped = {};
515 │       for (const sale of salesWithProducts) {
516 │         const date = new Date(sale.soldAt).toLocaleDateString();
517 │         if (!salesByDate[date]) salesByDate[date] = [];
518 │         salesByDate[date].push(sale);
519 │       }
520 │       return salesByDate;
521 │     }
522 │ 
523 │     const totalPages = total === 0 ? 0 : Math.ceil(total / query.limit);
524 │     return {
525 │       sales: salesWithProducts,
526 │       closing,
527 │       pagination: {
528 │         page: query.page,
529 │         limit: query.limit,
530 │         total,
531 │         totalPages,
532 │         hasNextPage: query.page < totalPages,
533 │       },
534 │     };
535 │   }
