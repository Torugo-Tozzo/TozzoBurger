+  const asyncDatabaseBridge = bridgeMethods.reduce((bridge, method) => {
+    bridge[method] = (...args: unknown[]) =>
+      new Promise((resolve, reject) => {
+        databaseBridge[method](...args, resolve, reject);
+      });
+    return bridge;
+  }, {} as Record<string, (...args: unknown[]) => Promise<unknown>>);
