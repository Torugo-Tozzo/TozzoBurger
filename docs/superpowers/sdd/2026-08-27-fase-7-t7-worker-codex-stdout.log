  },
  detailText: {
    fontSize: type.body,
    marginBottom: spacing.xs,
  },
  itemsFrame: { marginBottom: spacing.lg },
  itemTextRight: { fontSize: type.body, fontWeight: '700', textAlign: 'right' },
  buttonContainer: {
    flexDirection: 'row',
    justifyContent: 'flex-end',
    alignItems: 'center',
    gap: spacing.md,
