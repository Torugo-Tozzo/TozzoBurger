+  async function getSalesReportByPeriod(
+    startDate: string,
+    endDate: string,
+    productTypeId?: string | number,
+  ) {
+    if (!currentEstablishmentId) return [];
+
+    const startPeriod = localPeriodBoundary(startDate, false);
+    const endPeriod = localPeriodBoundary(endDate, true);
