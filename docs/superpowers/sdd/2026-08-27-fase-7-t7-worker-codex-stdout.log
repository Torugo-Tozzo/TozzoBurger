-  const horaFinal = horaFinalValue ? parseTime(horaFinalValue, 'horaFinal') : undefined;
-  const totalMin = optionalNumber(filters.totalMin, 'totalMin');
-  const totalMax = optionalNumber(filters.totalMax, 'totalMax');
