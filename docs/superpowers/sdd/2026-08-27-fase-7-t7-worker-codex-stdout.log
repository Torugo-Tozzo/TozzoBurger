+
+    const { createFromSync } = useSaleDatabase();
+    await expect(createFromSync({
+      id: 'synced-sale-1',
+      total: 25,
+      soldAt: '2026-08-20T12:00:00.000Z',
+      customerName: 'Sync',
+      isCancelled: false,
+      establishmentId: 'establishment-1',
+      updated_at: 1234,
+      items: [{ id: 'synced-item-1', saleId: 'synced-sale-1', productId: 'product-1', quantity: 1 }],
