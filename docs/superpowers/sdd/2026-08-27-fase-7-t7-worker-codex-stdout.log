+      closing: 50,
+      pagination: {
+        page: 1,
+        limit: 10,
+        total: 1,
+        totalPages: 1,
+        hasNextPage: false,
+      },
+    });
+  });
+
+  it('builds Watermelon clauses with establishment and date filters instead of SQL', () => {
+    const query = buildLocalSalesQuery({
+      dataInicial: '2026-08-20',
+      dataFinal: '2026-08-21',
+      customerName: 'Ana',
