+    })).resolves.toEqual({ saleId: 'synced-sale-1' });
+
+    await expect(mockDatabase.get<Sale>('sales').find('synced-sale-1')).resolves.toMatchObject({
+      soldAt: new Date('2026-08-20T12:00:00.000Z'),
