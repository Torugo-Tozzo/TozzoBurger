176 │   if (dataInicial) clauses.push(Q.where('sold_at', Q.gte(dateBoundary(dataInicial, horaInicial, false))));
177 │   if (dataFinal) clauses.push(Q.where('sold_at', Q.lte(dateBoundary(dataFinal, horaFinal, true))));
178 │   if (customerName) {
179 │     clauses.push(Q.where('customer_name', Q.like(`%${Q.sanitizeLikeString(customerName)}%`)));
180 │   }
181 │   if (totalMin != null) clauses.push(Q.where('total', Q.gte(totalMin)));
182 │   if (totalMax != null) clauses.push(Q.where('total', Q.lte(totalMax)));
183 │ 
184 │   const hasTimeFilter = horaInicial != null || horaFinal != null;
185 │   const timezoneOffsetMinutes = hasTimeFilter
186 │     ? parseTimezoneOffsetMinutes(filters.timezoneOffsetMinutes)
187 │     : 0;
188 │ 
189 │   return {
190 │     clauses,
191 │     page,
192 │     limit,
193 │     matchesTime: makeTimeMatcher(horaInicial, horaFinal, timezoneOffsetMinutes),
194 │   };
