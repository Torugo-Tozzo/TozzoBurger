+    const order = await seedOrder(mockDatabase, {
+      id: 'order-1',
+      establishmentId: 'establishment-1',
+      total: 51,
+      customerName: 'Ana',
+      sellerId: 'seller-1',
+      items: [{
+        productId: 'product-1',
