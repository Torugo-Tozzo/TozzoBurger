{
  "expo": {
    "name": "TozzoUk",
    "slug": "TozzoBurger",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-geral.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon-geral.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-geral.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "package": "com.torugotozzo.TozzoUk"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "react-native-ble-plx",
      "expo-sqlite",
      "expo-secure-store",
      "expo-localization",
      "./plugins/withWatermelonJsi.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "94ac2489-a7fb-4f9d-b3fa-cdf2a22d9019"
      }
    }
  }
}
